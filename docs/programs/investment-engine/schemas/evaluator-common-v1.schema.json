{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asxos.local/schemas/evaluator-common-v1.schema.json",
  "title": "ASXOS evaluator common definitions v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {},
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{5,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decimal6": {
      "type": "string",
      "pattern": "^(?:(?:0|[1-9][0-9]{0,11})\\.[0-9]{6}|-(?!0\\.000000$)(?:0|[1-9][0-9]{0,11})\\.[0-9]{6})$"
    },
    "nonNegativeDecimal6": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,11})\\.[0-9]{6}$"
    },
    "positiveDecimal6": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,11}\\.[0-9]{6}|0\\.(?!000000$)[0-9]{6})$"
    },
    "unitDecimal6": {
      "type": "string",
      "pattern": "^(?:0\\.[0-9]{6}|1\\.000000)$"
    },
    "positiveIntegerString": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "nonNegativeIntegerString": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)$"
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
    },
    "branchId": {
      "enum": [
        "PROPOSAL_BASE",
        "PROPOSAL_STRESS",
        "HOLD",
        "XJO_TR",
        "CASH"
      ]
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_name",
        "artifact_id",
        "schema_version",
        "sha256",
        "created_at"
      ],
      "properties": {
        "contract_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+-v[0-9]+$"
        },
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "schema_version": {
          "$ref": "#/$defs/version"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "record_id",
        "observed_at",
        "published_at",
        "available_at",
        "sha256"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "record_id": {
          "$ref": "#/$defs/identifier"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "published_at": {
          "$ref": "#/$defs/timestamp"
        },
        "available_at": {
          "$ref": "#/$defs/timestamp"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sourceHashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "sha256"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "canonicalHash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "hash_algorithm",
        "excluded_json_pointer",
        "payload_sha256"
      ],
      "properties": {
        "canonicalization": {
          "const": "RFC8785"
        },
        "hash_algorithm": {
          "const": "SHA-256"
        },
        "excluded_json_pointer": {
          "const": "/canonical_hash/payload_sha256"
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "reasonCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reasonCode"
      }
    }
  }
}
