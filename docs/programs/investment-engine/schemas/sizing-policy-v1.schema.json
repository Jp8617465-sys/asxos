{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asxos.local/schemas/sizing-policy-v1.schema.json",
  "title": "ASXOS Sizing Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "schema_version",
    "producer_version",
    "data_as_of",
    "created_at",
    "source_hashes",
    "sizing_policy_id",
    "sizing_policy_version",
    "effective_from",
    "effective_to",
    "method",
    "approval",
    "policy_refs",
    "constraint_sequence",
    "classification_requirements",
    "limits",
    "rounding",
    "failure_actions",
    "controls",
    "canonical_hash"
  ],
  "properties": {
    "contract_name": {
      "const": "sizing-policy-v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "producer_version": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/version"
    },
    "data_as_of": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "source_hashes": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/sourceHashes"
    },
    "sizing_policy_id": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
    },
    "sizing_policy_version": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/version"
    },
    "effective_from": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "effective_to": {
      "oneOf": [
        {
          "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "method": {
      "const": "POLICY_CAPPED_BOARD_LOT"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "ratified_by",
        "ratified_at",
        "approval_sha256"
      ],
      "properties": {
        "status": {
          "const": "RATIFIED"
        },
        "ratified_by": {
          "const": "James"
        },
        "ratified_at": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
        },
        "approval_sha256": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "policy_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "construction_policy_ref",
        "risk_policy_ref"
      ],
      "properties": {
        "construction_policy_ref": {
          "allOf": [
            {
              "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
            },
            {
              "properties": {
                "contract_name": {
                  "const": "portfolio-construction-policy-v1"
                }
              }
            }
          ]
        },
        "risk_policy_ref": {
          "allOf": [
            {
              "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
            },
            {
              "properties": {
                "contract_name": {
                  "const": "risk-policy-v1"
                }
              }
            }
          ]
        }
      }
    },
    "constraint_sequence": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "uniqueItems": true,
      "prefixItems": [
        {
          "const": "CLASSIFICATION"
        },
        {
          "const": "TARGET_NOTIONAL"
        },
        {
          "const": "AVAILABLE_CASH"
        },
        {
          "const": "ISSUER"
        },
        {
          "const": "CORPORATE_GROUP"
        },
        {
          "const": "SINGLE_NAME"
        },
        {
          "const": "SECTOR"
        },
        {
          "const": "THEME"
        },
        {
          "const": "PORTFOLIO_LOSS_AT_STOP"
        },
        {
          "const": "GROSS_EXPOSURE"
        },
        {
          "const": "NET_EXPOSURE"
        },
        {
          "const": "RESERVATIONS"
        },
        {
          "const": "TURNOVER"
        },
        {
          "const": "ADV_PARTICIPATION"
        },
        {
          "const": "SPREAD"
        },
        {
          "const": "LOSS_HEADROOM"
        },
        {
          "const": "TICK_RULE"
        },
        {
          "const": "BOARD_LOT"
        },
        {
          "const": "MINIMUM_ORDER"
        },
        {
          "const": "FEES"
        }
      ],
      "items": false
    },
    "classification_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_proposal_snapshot_match",
        "complete_status_required",
        "admissible_status_required",
        "effective_board_lot_required",
        "effective_tick_rule_required",
        "missing_or_ambiguous_action"
      ],
      "properties": {
        "exact_proposal_snapshot_match": {
          "const": true
        },
        "complete_status_required": {
          "const": true
        },
        "admissible_status_required": {
          "const": true
        },
        "effective_board_lot_required": {
          "const": true
        },
        "effective_tick_rule_required": {
          "const": true
        },
        "missing_or_ambiguous_action": {
          "const": "REJECTED_NO_POLICY"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_cap_operator",
        "available_cash_reserve_fraction",
        "maximum_single_order_nav_fraction",
        "maximum_order_adv_fraction",
        "maximum_spread_fraction",
        "minimum_loss_headroom_aud",
        "minimum_order_aud",
        "maximum_fee_fraction",
        "sell_quantity_basis"
      ],
      "properties": {
        "binding_cap_operator": {
          "const": "MINIMUM_OF_ALL_APPLICABLE_LIMITS"
        },
        "available_cash_reserve_fraction": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/unitDecimal6"
        },
        "maximum_single_order_nav_fraction": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/unitDecimal6"
        },
        "maximum_order_adv_fraction": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/unitDecimal6"
        },
        "maximum_spread_fraction": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/unitDecimal6"
        },
        "minimum_loss_headroom_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "minimum_order_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/positiveDecimal6"
        },
        "maximum_fee_fraction": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/unitDecimal6"
        },
        "sell_quantity_basis": {
          "const": "ELIGIBLE_SETTLED_LOTS_ONLY"
        }
      }
    },
    "rounding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "working_precision",
        "money_scale",
        "mode",
        "quantity_rule",
        "price_rule",
        "post_round_revalidation"
      ],
      "properties": {
        "working_precision": {
          "const": "DECIMAL_34"
        },
        "money_scale": {
          "const": "6"
        },
        "mode": {
          "const": "ROUND_HALF_EVEN"
        },
        "quantity_rule": {
          "const": "FLOOR_TO_EFFECTIVE_BOARD_LOT"
        },
        "price_rule": {
          "const": "ADVERSE_TO_EFFECTIVE_TICK"
        },
        "post_round_revalidation": {
          "const": true
        }
      }
    },
    "failure_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_or_ambiguous_policy",
        "constraint_breach_after_reduction",
        "missing_market_or_portfolio_input",
        "missing_or_ambiguous_classification",
        "implicit_default_permitted"
      ],
      "properties": {
        "missing_or_ambiguous_policy": {
          "const": "REJECTED_NO_POLICY"
        },
        "constraint_breach_after_reduction": {
          "const": "REJECTED_POLICY_VIOLATION"
        },
        "missing_market_or_portfolio_input": {
          "const": "REJECTED_NO_POLICY"
        },
        "missing_or_ambiguous_classification": {
          "const": "REJECTED_NO_POLICY"
        },
        "implicit_default_permitted": {
          "const": false
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_mode",
        "deterministic",
        "proposal_quantity_increase_permitted",
        "analytical_ranking_input_permitted",
        "non_executable",
        "live_holdings_write"
      ],
      "properties": {
        "evaluation_mode": {
          "const": "PAPER_ONLY"
        },
        "deterministic": {
          "const": true
        },
        "proposal_quantity_increase_permitted": {
          "const": false
        },
        "analytical_ranking_input_permitted": {
          "const": false
        },
        "non_executable": {
          "const": true
        },
        "live_holdings_write": {
          "const": false
        }
      }
    },
    "canonical_hash": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/canonicalHash"
    }
  }
}
