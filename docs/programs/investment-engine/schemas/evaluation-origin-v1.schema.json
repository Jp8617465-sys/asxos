{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asxos.local/schemas/evaluation-origin-v1.schema.json",
  "title": "ASXOS Evaluation Origin v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "schema_version",
    "producer_version",
    "data_as_of",
    "created_at",
    "source_hashes",
    "origin_id",
    "config_ref",
    "candidate_family_id",
    "schedule_id",
    "origin_sequence",
    "scheduled_for",
    "knowledge_cutoff",
    "opened_at",
    "origin_status",
    "prospective",
    "reconstructed",
    "dependency_group_id",
    "overlap_group_ids",
    "starting_state_hash_basis",
    "starting_state_sha256",
    "snapshot_manifest",
    "missing_required_inputs",
    "branches",
    "reason_codes",
    "canonical_hash",
    "controls"
  ],
  "properties": {
    "contract_name": {
      "const": "evaluation-origin-v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "producer_version": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/version"
    },
    "data_as_of": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "source_hashes": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/sourceHashes"
    },
    "canonical_hash": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/canonicalHash"
    },
    "origin_id": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
    },
    "config_ref": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
    },
    "candidate_family_id": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
    },
    "schedule_id": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
    },
    "origin_sequence": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/positiveIntegerString"
    },
    "scheduled_for": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "knowledge_cutoff": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "opened_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "origin_status": {
      "enum": [
        "OPEN",
        "BLOCKED",
        "REJECTED",
        "NO_ACTION",
        "INVALID"
      ]
    },
    "prospective": {
      "const": true
    },
    "reconstructed": {
      "const": false
    },
    "dependency_group_id": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
    },
    "overlap_group_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
      }
    },
    "starting_state_hash_basis": {
      "const": "PORTFOLIO_SNAPSHOT_CANONICAL_HASH"
    },
    "starting_state_sha256": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
    },
    "snapshot_manifest": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "snapshot_class",
          "ref"
        ],
        "properties": {
          "snapshot_class": {
            "enum": [
              "PORTFOLIO",
              "LOTS",
              "CASH",
              "PROPOSAL",
              "REPORT",
              "REVIEW",
              "CONSTRUCTION",
              "RISK_POLICY",
              "SIZING",
              "STAGING_POLICY",
              "PRICE",
              "FX",
              "BENCHMARK",
              "FEE_SCHEDULE",
              "TAX_PROFILE",
              "CORPORATE_ACTIONS",
              "TRADING_CALENDAR"
            ]
          },
          "ref": {
            "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "snapshot_class": {
                  "const": "PORTFOLIO"
                }
              },
              "required": [
                "snapshot_class"
              ]
            },
            "then": {
              "properties": {
                "ref": {
                  "properties": {
                    "contract_name": {
                      "const": "portfolio-snapshot-v1"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "snapshot_class": {
                  "const": "PROPOSAL"
                }
              },
              "required": [
                "snapshot_class"
              ]
            },
            "then": {
              "properties": {
                "ref": {
                  "properties": {
                    "contract_name": {
                      "const": "portfolio-proposal-v1"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "snapshot_class": {
                  "const": "BENCHMARK"
                }
              },
              "required": [
                "snapshot_class"
              ]
            },
            "then": {
              "properties": {
                "ref": {
                  "properties": {
                    "contract_name": {
                      "const": "benchmark-snapshot-v1"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "snapshot_class": {
                  "const": "SIZING"
                }
              },
              "required": [
                "snapshot_class"
              ]
            },
            "then": {
              "properties": {
                "ref": {
                  "properties": {
                    "contract_name": {
                      "const": "sizing-policy-v1"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "snapshot_class": {
                  "const": "TAX_PROFILE"
                }
              },
              "required": [
                "snapshot_class"
              ]
            },
            "then": {
              "properties": {
                "ref": {
                  "properties": {
                    "contract_name": {
                      "const": "tax-profile-v1"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "snapshot_class": {
                  "const": "TRADING_CALENDAR"
                }
              },
              "required": [
                "snapshot_class"
              ]
            },
            "then": {
              "properties": {
                "ref": {
                  "properties": {
                    "contract_name": {
                      "const": "trading-calendar-v1"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "missing_required_inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "PORTFOLIO",
          "LOTS",
          "CASH",
          "PROPOSAL",
          "REPORT",
          "REVIEW",
          "CONSTRUCTION",
          "RISK_POLICY",
          "SIZING",
          "STAGING_POLICY",
          "PRICE",
          "FX",
          "BENCHMARK",
          "FEE_SCHEDULE",
          "TAX_PROFILE",
          "CORPORATE_ACTIONS",
          "TRADING_CALENDAR"
        ]
      }
    },
    "branches": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "properties": {
              "branch_id": {
                "const": "PROPOSAL_BASE"
              }
            },
            "required": [
              "branch_id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "branch_id": {
                "const": "PROPOSAL_STRESS"
              }
            },
            "required": [
              "branch_id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "branch_id": {
                "const": "HOLD"
              }
            },
            "required": [
              "branch_id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "branch_id": {
                "const": "XJO_TR"
              }
            },
            "required": [
              "branch_id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "branch_id": {
                "const": "CASH"
              }
            },
            "required": [
              "branch_id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "branch_id",
          "branch_status",
          "starting_state_sha256"
        ],
        "properties": {
          "branch_id": {
            "$ref": "evaluator-common-v1.schema.json#/$defs/branchId"
          },
          "branch_status": {
            "enum": [
              "FROZEN",
              "BLOCKED"
            ]
          },
          "starting_state_sha256": {
            "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
          }
        }
      }
    },
    "reason_codes": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/reasonCodes"
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_known_at_open",
        "origin_mutable",
        "evaluation_mode"
      ],
      "properties": {
        "outcome_known_at_open": {
          "const": false
        },
        "origin_mutable": {
          "const": false
        },
        "evaluation_mode": {
          "const": "PAPER_ONLY"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "origin_status": {
            "const": "OPEN"
          }
        },
        "required": [
          "origin_status"
        ]
      },
      "then": {
        "properties": {
          "missing_required_inputs": {
            "maxItems": 0
          },
          "snapshot_manifest": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "snapshot_class": {
                      "const": "PORTFOLIO"
                    }
                  },
                  "required": [
                    "snapshot_class"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "snapshot_class": {
                      "const": "PROPOSAL"
                    }
                  },
                  "required": [
                    "snapshot_class"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "snapshot_class": {
                      "const": "BENCHMARK"
                    }
                  },
                  "required": [
                    "snapshot_class"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "snapshot_class": {
                      "const": "SIZING"
                    }
                  },
                  "required": [
                    "snapshot_class"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "snapshot_class": {
                      "const": "TAX_PROFILE"
                    }
                  },
                  "required": [
                    "snapshot_class"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "snapshot_class": {
                      "const": "TRADING_CALENDAR"
                    }
                  },
                  "required": [
                    "snapshot_class"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "origin_status": {
            "const": "BLOCKED"
          }
        },
        "required": [
          "origin_status"
        ]
      },
      "then": {
        "properties": {
          "missing_required_inputs": {
            "minItems": 1
          },
          "reason_codes": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
