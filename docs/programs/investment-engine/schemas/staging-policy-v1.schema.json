{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asxos.local/schemas/staging-policy-v1.schema.json",
  "title": "Staging Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "schema_version",
    "policy_id",
    "policy_version",
    "effective_from",
    "effective_to",
    "approval",
    "scope",
    "limit_price",
    "schedule",
    "freshness",
    "invalidation_codes",
    "controls",
    "source_hashes",
    "created_at",
    "canonical_hash"
  ],
  "properties": {
    "contract_name": {
      "const": "staging-policy-v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "policy_id": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
    },
    "policy_version": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/version"
    },
    "effective_from": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
    },
    "effective_to": {
      "oneOf": [
        {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "approval": {
      "$ref": "#/$defs/approval"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "limit_price": {
      "$ref": "#/$defs/limitPrice"
    },
    "schedule": {
      "$ref": "#/$defs/schedule"
    },
    "freshness": {
      "$ref": "#/$defs/freshness"
    },
    "invalidation_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "EXPIRED",
          "STALE_PRICE",
          "STALE_FX",
          "STALE_HOLDINGS",
          "STALE_TAX",
          "STALE_LIQUIDITY",
          "REPORT_CHANGED",
          "REVIEW_CHANGED",
          "MONITOR_WATERMARK_CHANGED",
          "EVALUATOR_CHANGED",
          "POLICY_CHANGED",
          "PROPOSAL_CHANGED",
          "SIZING_CHANGED",
          "OPEN_BLOCKING_FINDING",
          "UNPROCESSED_MATERIAL_EVENT",
          "GATE_REGRESSION",
          "ARITHMETIC_MISMATCH"
        ]
      }
    },
    "controls": {
      "$ref": "#/$defs/controls"
    },
    "source_hashes": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/sourceHashes"
    },
    "created_at": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
    },
    "canonical_hash": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/canonicalHash"
    }
  },
  "$defs": {
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ratified_by",
        "ratified_at",
        "approval_sha256"
      ],
      "properties": {
        "ratified_by": {
          "const": "James"
        },
        "ratified_at": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
        },
        "approval_sha256": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portfolio_id",
        "venue",
        "currency",
        "environment"
      ],
      "properties": {
        "portfolio_id": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
        },
        "venue": {
          "const": "XASX"
        },
        "currency": {
          "const": "AUD"
        },
        "environment": {
          "const": "PAPER_ONLY"
        }
      }
    },
    "limitPrice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "max_adverse_limit_fraction",
        "tick_size_aud",
        "buy_rounding",
        "sell_rounding",
        "market_orders_permitted"
      ],
      "properties": {
        "method": {
          "const": "REFERENCE_PRICE_WITH_MAX_ADVERSE_FRACTION"
        },
        "max_adverse_limit_fraction": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/unitDecimal"
        },
        "tick_size_aud": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/positiveDecimal"
        },
        "buy_rounding": {
          "const": "FLOOR_TO_TICK"
        },
        "sell_rounding": {
          "const": "CEILING_TO_TICK"
        },
        "market_orders_permitted": {
          "const": false
        }
      }
    },
    "stageRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "quantity_fraction",
        "eligible_session_offset"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "quantity_fraction": {
          "$ref": "#/$defs/positiveUnitDecimal"
        },
        "eligible_session_offset": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_before_rule",
        "stages",
        "remainder_rule",
        "validity_sessions",
        "expiry_rule",
        "overlap_permitted"
      ],
      "properties": {
        "not_before_rule": {
          "const": "NEXT_ELIGIBLE_ASX_MARKET_EVENT"
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stageRule"
          }
        },
        "remainder_rule": {
          "const": "FINAL_STAGE_AFTER_BOARD_LOT_FLOOR"
        },
        "validity_sessions": {
          "type": "integer",
          "minimum": 1
        },
        "expiry_rule": {
          "const": "END_OF_LAST_VALID_ASX_SESSION"
        },
        "overlap_permitted": {
          "const": false
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_price_age_seconds",
        "max_fx_age_seconds",
        "require_current_holdings",
        "require_current_monitor_watermark"
      ],
      "properties": {
        "max_price_age_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_fx_age_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "require_current_holdings": {
          "const": true
        },
        "require_current_monitor_watermark": {
          "const": true
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_mode",
        "non_executable",
        "system_terminal_state",
        "auto_approval_permitted",
        "fallback_order_permitted"
      ],
      "properties": {
        "execution_mode": {
          "const": "PAPER_ONLY"
        },
        "non_executable": {
          "const": true
        },
        "system_terminal_state": {
          "const": "ORDER_STAGED"
        },
        "auto_approval_permitted": {
          "const": false
        },
        "fallback_order_permitted": {
          "const": false
        }
      }
    },
    "positiveUnitDecimal": {
      "type": "string",
      "pattern": "^(?:0\\.(?!000000$)[0-9]{6}|1\\.000000)$"
    }
  }
}
