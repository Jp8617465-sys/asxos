{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asxos.local/schemas/trading-calendar-v1.schema.json",
  "title": "ASXOS Trading Calendar v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "schema_version",
    "producer_version",
    "data_as_of",
    "created_at",
    "source_hashes",
    "calendar_id",
    "calendar_version",
    "venue",
    "source_timezone",
    "timezone_rules_sha256",
    "exchange_schedule_sha256",
    "holiday_schedule_sha256",
    "published_at",
    "coverage_start",
    "coverage_end",
    "settlement",
    "sessions",
    "incomplete_action",
    "controls",
    "canonical_hash"
  ],
  "properties": {
    "contract_name": {
      "const": "trading-calendar-v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "producer_version": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/version"
    },
    "data_as_of": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "source_hashes": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/sourceHashes"
    },
    "calendar_id": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
    },
    "calendar_version": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/version"
    },
    "venue": {
      "const": "XASX"
    },
    "source_timezone": {
      "const": "Australia/Sydney"
    },
    "timezone_rules_sha256": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
    },
    "exchange_schedule_sha256": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
    },
    "holiday_schedule_sha256": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
    },
    "published_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "coverage_start": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/date"
    },
    "coverage_end": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/date"
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cycle",
        "business_day_basis",
        "currency",
        "exception_policy",
        "failed_mapping_action"
      ],
      "properties": {
        "cycle": {
          "const": "T_PLUS_2_BUSINESS_SESSIONS"
        },
        "business_day_basis": {
          "const": "OPEN_XASX_SESSIONS"
        },
        "currency": {
          "const": "AUD"
        },
        "exception_policy": {
          "const": "SOURCE_PUBLISHED_EFFECTIVE_DATE"
        },
        "failed_mapping_action": {
          "const": "UNAVAILABLE_NO_INFERENCE"
        }
      }
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/session"
      }
    },
    "incomplete_action": {
      "const": "BLOCK_ORIGIN_FILL_SETTLEMENT_NAV_AND_OUTCOME"
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_mode",
        "immutable",
        "utc_materialized",
        "machine_timezone_lookup_permitted",
        "non_executable",
        "market_access",
        "live_holdings_write"
      ],
      "properties": {
        "evaluation_mode": {
          "const": "PAPER_ONLY"
        },
        "immutable": {
          "const": true
        },
        "utc_materialized": {
          "const": true
        },
        "machine_timezone_lookup_permitted": {
          "const": false
        },
        "non_executable": {
          "const": true
        },
        "market_access": {
          "const": "ABSENT"
        },
        "live_holdings_write": {
          "const": false
        }
      }
    },
    "canonical_hash": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/canonicalHash"
    }
  },
  "$defs": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "session_sequence",
        "session_date",
        "status",
        "open_at",
        "close_at",
        "settlement_date",
        "source_sha256"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "^XASX-[0-9]{8}$"
        },
        "session_sequence": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/positiveIntegerString"
        },
        "session_date": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/date"
        },
        "status": {
          "enum": [
            "OPEN",
            "EARLY_CLOSE",
            "CLOSED"
          ]
        },
        "open_at": {
          "oneOf": [
            {
              "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "close_at": {
          "oneOf": [
            {
              "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "settlement_date": {
          "oneOf": [
            {
              "$ref": "evaluator-common-v1.schema.json#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_sha256": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "OPEN",
                  "EARLY_CLOSE"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "open_at": {
                "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
              },
              "close_at": {
                "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
              },
              "settlement_date": {
                "$ref": "evaluator-common-v1.schema.json#/$defs/date"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "CLOSED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "open_at": {
                "type": "null"
              },
              "close_at": {
                "type": "null"
              },
              "settlement_date": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
