{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asxos.local/schemas/tax-profile-v1.schema.json",
  "title": "ASXOS Tax Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "schema_version",
    "producer_version",
    "data_as_of",
    "created_at",
    "source_hashes",
    "tax_profile_id",
    "tax_profile_version",
    "subject_id",
    "profile_basis",
    "jurisdiction",
    "entity_class",
    "tax_year",
    "effective_from",
    "effective_to",
    "available_at",
    "status",
    "approval",
    "rates",
    "capital_gains",
    "income_treatment",
    "opening_loss_state",
    "branch_state_policy",
    "missing_assumptions",
    "reason_codes",
    "controls",
    "canonical_hash"
  ],
  "properties": {
    "contract_name": {
      "const": "tax-profile-v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "producer_version": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/version"
    },
    "data_as_of": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "source_hashes": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/sourceHashes"
    },
    "tax_profile_id": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
    },
    "tax_profile_version": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/version"
    },
    "subject_id": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
    },
    "profile_basis": {
      "const": "JAMES_RATIFIED_PAPER_SCENARIO"
    },
    "jurisdiction": {
      "const": "AU"
    },
    "entity_class": {
      "const": "INDIVIDUAL_RESIDENT_PAPER_SCENARIO"
    },
    "tax_year": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{4}$"
    },
    "effective_from": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "effective_to": {
      "oneOf": [
        {
          "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "available_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "INCOMPLETE"
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "ratified_by",
        "ratified_at",
        "approval_sha256"
      ],
      "properties": {
        "status": {
          "const": "RATIFIED"
        },
        "ratified_by": {
          "const": "James"
        },
        "ratified_at": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
        },
        "approval_sha256": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "rates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinary_income_effective_rate",
        "short_holding_capital_gain_rate",
        "long_holding_capital_gain_rate",
        "cash_interest_rate",
        "rate_interpretation"
      ],
      "properties": {
        "ordinary_income_effective_rate": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/unitDecimal6"
        },
        "short_holding_capital_gain_rate": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/unitDecimal6"
        },
        "long_holding_capital_gain_rate": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/unitDecimal6"
        },
        "cash_interest_rate": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/unitDecimal6"
        },
        "rate_interpretation": {
          "const": "FRACTION_OF_TAXABLE_AMOUNT"
        }
      }
    },
    "capital_gains": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discount_eligible",
        "discount_fraction",
        "minimum_holding_days",
        "holding_period_basis",
        "transaction_costs_in_cost_base",
        "realization_event"
      ],
      "properties": {
        "discount_eligible": {
          "type": "boolean"
        },
        "discount_fraction": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/unitDecimal6"
        },
        "minimum_holding_days": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/positiveIntegerString"
        },
        "holding_period_basis": {
          "const": "ACQUISITION_TO_DISPOSAL_DATE"
        },
        "transaction_costs_in_cost_base": {
          "const": true
        },
        "realization_event": {
          "const": "DISPOSAL_TRADE_DATE"
        }
      }
    },
    "income_treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cash_dividend",
        "franking_credit_recognition",
        "franking_credit_utilization",
        "cash_interest",
        "unknown_entitlement_action"
      ],
      "properties": {
        "cash_dividend": {
          "const": "ORDINARY_INCOME_AT_ENTITLEMENT"
        },
        "franking_credit_recognition": {
          "const": "KNOWN_ENTITLEMENT_ONLY"
        },
        "franking_credit_utilization": {
          "const": "OFFSET_ESTIMATED_TAX_NO_REFUND_ASSUMED"
        },
        "cash_interest": {
          "const": "ORDINARY_INCOME_AT_ACCRUAL"
        },
        "unknown_entitlement_action": {
          "const": "UNAVAILABLE_NO_ZERO_FALLBACK"
        }
      }
    },
    "opening_loss_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of",
        "carried_capital_loss_aud",
        "carried_revenue_loss_aud",
        "state_sha256"
      ],
      "properties": {
        "as_of": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
        },
        "carried_capital_loss_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "carried_revenue_loss_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "state_sha256": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "branch_state_policy": {
      "const": "COPY_OPENING_STATE_THEN_ISOLATE_EACH_COUNTERFACTUAL"
    },
    "missing_assumptions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "JURISDICTION",
          "ENTITY_CLASS",
          "TAX_YEAR",
          "ORDINARY_RATE",
          "CAPITAL_GAIN_RATE",
          "DISCOUNT_ELIGIBILITY",
          "FRANKING_ENTITLEMENT",
          "OPENING_LOSS_STATE",
          "EFFECTIVE_INTERVAL"
        ]
      }
    },
    "reason_codes": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/reasonCodes"
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_mode",
        "output_class",
        "tax_return",
        "tax_advice",
        "branch_state_shared",
        "unknown_value_zero_fallback",
        "non_executable",
        "live_holdings_write"
      ],
      "properties": {
        "evaluation_mode": {
          "const": "PAPER_ONLY"
        },
        "output_class": {
          "const": "POINT_IN_TIME_ESTIMATE"
        },
        "tax_return": {
          "const": false
        },
        "tax_advice": {
          "const": false
        },
        "branch_state_shared": {
          "const": false
        },
        "unknown_value_zero_fallback": {
          "const": false
        },
        "non_executable": {
          "const": true
        },
        "live_holdings_write": {
          "const": false
        }
      }
    },
    "canonical_hash": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/canonicalHash"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "COMPLETE"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "missing_assumptions": {
            "maxItems": 0
          },
          "reason_codes": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "INCOMPLETE"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "missing_assumptions": {
            "minItems": 1
          },
          "reason_codes": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
