{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asxos.local/schemas/portfolio-snapshot-v1.schema.json",
  "title": "ASXOS Portfolio Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "schema_version",
    "producer_version",
    "data_as_of",
    "created_at",
    "source_hashes",
    "portfolio_snapshot_id",
    "portfolio_snapshot_version",
    "portfolio_id",
    "knowledge_cutoff",
    "valuation_at",
    "base_currency",
    "status",
    "cash_balances",
    "positions",
    "components",
    "total_nav_aud",
    "reconciliation",
    "missing_data_classes",
    "reason_codes",
    "controls",
    "canonical_hash"
  ],
  "properties": {
    "contract_name": {
      "const": "portfolio-snapshot-v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "producer_version": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/version"
    },
    "data_as_of": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "source_hashes": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/sourceHashes"
    },
    "portfolio_snapshot_id": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
    },
    "portfolio_snapshot_version": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/version"
    },
    "portfolio_id": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
    },
    "knowledge_cutoff": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "valuation_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "base_currency": {
      "const": "AUD"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "INCOMPLETE"
      ]
    },
    "cash_balances": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/cashBalance"
      }
    },
    "positions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/position"
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cash_aud",
        "positions_aud",
        "receivables_aud",
        "payables_aud",
        "accrued_fees_aud",
        "realized_tax_payable_aud",
        "deferred_tax_liability_aud"
      ],
      "properties": {
        "cash_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "positions_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "receivables_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "payables_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "accrued_fees_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "realized_tax_payable_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "deferred_tax_liability_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        }
      }
    },
    "total_nav_aud": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reconciled",
        "difference_aud",
        "tolerance_aud",
        "producer_reconciled_boolean_trusted"
      ],
      "properties": {
        "reconciled": {
          "type": "boolean"
        },
        "difference_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/decimal6"
        },
        "tolerance_aud": {
          "const": "0.000001"
        },
        "producer_reconciled_boolean_trusted": {
          "const": false
        }
      }
    },
    "missing_data_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "CASH",
          "POSITION",
          "TAX_LOT",
          "PRICE",
          "FX",
          "CORPORATE_ACTION",
          "RECEIVABLE",
          "PAYABLE",
          "FEE",
          "TAX",
          "RECONCILIATION"
        ]
      }
    },
    "reason_codes": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/reasonCodes"
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_mode",
        "immutable",
        "read_only",
        "non_executable",
        "live_holdings_write",
        "routeable_identifiers_present",
        "missing_value_zero_fallback"
      ],
      "properties": {
        "evaluation_mode": {
          "const": "PAPER_ONLY"
        },
        "immutable": {
          "const": true
        },
        "read_only": {
          "const": true
        },
        "non_executable": {
          "const": true
        },
        "live_holdings_write": {
          "const": false
        },
        "routeable_identifiers_present": {
          "const": false
        },
        "missing_value_zero_fallback": {
          "const": false
        }
      }
    },
    "canonical_hash": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/canonicalHash"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "COMPLETE"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reconciliation": {
            "properties": {
              "reconciled": {
                "const": true
              },
              "difference_aud": {
                "const": "0.000000"
              }
            }
          },
          "missing_data_classes": {
            "maxItems": 0
          },
          "reason_codes": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "INCOMPLETE"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "missing_data_classes": {
            "minItems": 1
          },
          "reason_codes": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "cashBalance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cash_balance_id",
        "currency",
        "settled_aud",
        "reserved_aud",
        "receivable_aud",
        "payable_aud",
        "total_aud",
        "available_at",
        "source_sha256"
      ],
      "properties": {
        "cash_balance_id": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
        },
        "currency": {
          "const": "AUD"
        },
        "settled_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "reserved_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "receivable_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "payable_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "total_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "available_at": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
        },
        "source_sha256": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "quantity",
        "price_aud",
        "market_value_aud",
        "price_source_ref",
        "lots"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^XASX:[A-Z0-9]{3,6}$"
        },
        "quantity": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/positiveIntegerString"
        },
        "price_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/positiveDecimal6"
        },
        "market_value_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/positiveDecimal6"
        },
        "price_source_ref": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/sourceRef"
        },
        "lots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/taxLot"
          }
        }
      }
    },
    "taxLot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lot_id",
        "acquired_at",
        "available_at",
        "quantity",
        "remaining_cost_base_aud",
        "source_sha256"
      ],
      "properties": {
        "lot_id": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
        },
        "acquired_at": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
        },
        "available_at": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
        },
        "quantity": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/positiveIntegerString"
        },
        "remaining_cost_base_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "source_sha256": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
        }
      }
    }
  }
}
