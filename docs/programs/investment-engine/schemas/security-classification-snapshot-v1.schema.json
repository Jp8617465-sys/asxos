{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asxos.local/schemas/security-classification-snapshot-v1.schema.json",
  "title": "ASXOS Security Classification Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "schema_version",
    "producer_version",
    "classification_snapshot_id",
    "classification_snapshot_version",
    "data_as_of",
    "knowledge_cutoff",
    "created_at",
    "scope",
    "status",
    "source_hashes",
    "assets",
    "missing_data_classes",
    "reason_codes",
    "incomplete_asset_action",
    "controls",
    "canonical_hash"
  ],
  "properties": {
    "contract_name": {
      "const": "security-classification-snapshot-v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "producer_version": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/version"
    },
    "classification_snapshot_id": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
    },
    "classification_snapshot_version": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/version"
    },
    "data_as_of": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "knowledge_cutoff": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "INCOMPLETE"
      ]
    },
    "source_hashes": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sourceHash"
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "missing_data_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "SECURITY_MASTER",
          "SECURITY_IDENTITY",
          "ISSUER_CLASSIFICATION",
          "CORPORATE_GROUP_CLASSIFICATION",
          "SECTOR_CLASSIFICATION",
          "THEME_MEMBERSHIP",
          "SECURITY_KIND",
          "VENUE_OR_CURRENCY",
          "EFFECTIVE_INTERVAL",
          "BOARD_LOT",
          "TRADING_RULE",
          "SOURCE_PROVENANCE",
          "SOURCE_HASH",
          "AMBIGUOUS_CLASSIFICATION",
          "AMBIGUOUS_TRADING_RULE"
        ]
      }
    },
    "reason_codes": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/reasonCodes"
    },
    "incomplete_asset_action": {
      "const": "INADMISSIBLE_NO_INFERENCE"
    },
    "controls": {
      "$ref": "#/$defs/controls"
    },
    "canonical_hash": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/canonicalHash"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "COMPLETE"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "source_hashes": {
            "minItems": 3,
            "maxItems": 3,
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "source": {
                      "const": "governed-security-master"
                    }
                  },
                  "required": [
                    "source"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "source": {
                      "const": "governed-theme-membership"
                    }
                  },
                  "required": [
                    "source"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "source": {
                      "const": "xasx-trading-rules"
                    }
                  },
                  "required": [
                    "source"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          },
          "assets": {
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/asset"
                },
                {
                  "properties": {
                    "classification_status": {
                      "const": "COMPLETE"
                    },
                    "admissible_for_construction": {
                      "const": true
                    }
                  }
                }
              ]
            }
          },
          "missing_data_classes": {
            "maxItems": 0
          },
          "reason_codes": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "INCOMPLETE"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "assets": {
            "contains": {
              "properties": {
                "classification_status": {
                  "const": "INCOMPLETE"
                }
              },
              "required": [
                "classification_status"
              ]
            },
            "minContains": 1
          },
          "missing_data_classes": {
            "minItems": 1
          },
          "reason_codes": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "nullableIdentifier": {
      "oneOf": [
        {
          "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableVenue": {
      "oneOf": [
        {
          "const": "XASX"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableCurrency": {
      "oneOf": [
        {
          "const": "AUD"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableSecurityKind": {
      "oneOf": [
        {
          "enum": [
            "au_equity",
            "etf",
            "lic",
            "reit",
            "hybrid"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "nullablePositiveIntegerString": {
      "oneOf": [
        {
          "$ref": "evaluator-common-v1.schema.json#/$defs/positiveIntegerString"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "venue",
        "currency",
        "position_direction"
      ],
      "properties": {
        "venue": {
          "const": "XASX"
        },
        "currency": {
          "const": "AUD"
        },
        "position_direction": {
          "const": "LONG_ONLY"
        }
      }
    },
    "sourceHash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "sha256"
      ],
      "properties": {
        "source": {
          "enum": [
            "governed-security-master",
            "governed-theme-membership",
            "xasx-trading-rules"
          ]
        },
        "sha256": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "effectiveInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effective_from",
        "effective_to"
      ],
      "properties": {
        "effective_from": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
        },
        "effective_to": {
          "oneOf": [
            {
              "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "nullableEffectiveInterval": {
      "oneOf": [
        {
          "$ref": "#/$defs/effectiveInterval"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenanceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "source_snapshot_id",
        "record_id",
        "observed_at",
        "published_at",
        "available_at",
        "record_sha256",
        "snapshot_sha256"
      ],
      "properties": {
        "source": {
          "enum": [
            "governed-security-master",
            "governed-theme-membership",
            "xasx-trading-rules"
          ]
        },
        "source_snapshot_id": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
        },
        "record_id": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
        },
        "observed_at": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
        },
        "published_at": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
        },
        "available_at": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
        },
        "record_sha256": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
        },
        "snapshot_sha256": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "securityMasterProvenanceRef": {
      "allOf": [
        {
          "$ref": "#/$defs/provenanceRef"
        },
        {
          "properties": {
            "source": {
              "const": "governed-security-master"
            }
          }
        }
      ]
    },
    "themeMembershipProvenanceRef": {
      "allOf": [
        {
          "$ref": "#/$defs/provenanceRef"
        },
        {
          "properties": {
            "source": {
              "const": "governed-theme-membership"
            }
          }
        }
      ]
    },
    "tradingRuleProvenanceRef": {
      "allOf": [
        {
          "$ref": "#/$defs/provenanceRef"
        },
        {
          "properties": {
            "source": {
              "const": "xasx-trading-rules"
            }
          }
        }
      ]
    },
    "nullableSecurityMasterProvenanceRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/securityMasterProvenanceRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableThemeMembershipProvenanceRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/themeMembershipProvenanceRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableTradingRuleProvenanceRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/tradingRuleProvenanceRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "security_master",
        "theme_membership",
        "trading_rule"
      ],
      "properties": {
        "security_master": {
          "$ref": "#/$defs/nullableSecurityMasterProvenanceRef"
        },
        "theme_membership": {
          "$ref": "#/$defs/nullableThemeMembershipProvenanceRef"
        },
        "trading_rule": {
          "$ref": "#/$defs/nullableTradingRuleProvenanceRef"
        }
      }
    },
    "tickBand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "band_sequence",
        "lower_bound_aud",
        "upper_bound_aud",
        "tick_size_aud",
        "lower_bound_inclusive",
        "upper_bound_exclusive"
      ],
      "properties": {
        "band_sequence": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/positiveIntegerString"
        },
        "lower_bound_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "upper_bound_aud": {
          "oneOf": [
            {
              "$ref": "evaluator-common-v1.schema.json#/$defs/positiveDecimal6"
            },
            {
              "type": "null"
            }
          ]
        },
        "tick_size_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/positiveDecimal6"
        },
        "lower_bound_inclusive": {
          "const": true
        },
        "upper_bound_exclusive": {
          "const": true
        }
      }
    },
    "tickRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tick_rule_id",
        "tick_rule_version",
        "rule_class",
        "price_basis",
        "effective_interval",
        "bands"
      ],
      "properties": {
        "tick_rule_id": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
        },
        "tick_rule_version": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/version"
        },
        "rule_class": {
          "const": "EQUITY_PRICE_STEP"
        },
        "price_basis": {
          "const": "ORDER_PRICE_AUD"
        },
        "effective_interval": {
          "$ref": "#/$defs/effectiveInterval"
        },
        "bands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/tickBand"
          }
        }
      }
    },
    "nullableTickRule": {
      "oneOf": [
        {
          "$ref": "#/$defs/tickRule"
        },
        {
          "type": "null"
        }
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "security_id",
        "issuer_id",
        "corporate_group_id",
        "sector_id",
        "theme_ids",
        "classification_status",
        "effective_interval",
        "venue",
        "currency",
        "security_kind",
        "board_lot_quantity",
        "tick_rule",
        "admissible_for_construction",
        "missing_fields",
        "reason_codes",
        "provenance"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^XASX:[A-Z0-9]{3,6}$"
        },
        "security_id": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "issuer_id": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "corporate_group_id": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "sector_id": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "theme_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
          }
        },
        "classification_status": {
          "enum": [
            "COMPLETE",
            "INCOMPLETE"
          ]
        },
        "effective_interval": {
          "$ref": "#/$defs/nullableEffectiveInterval"
        },
        "venue": {
          "$ref": "#/$defs/nullableVenue"
        },
        "currency": {
          "$ref": "#/$defs/nullableCurrency"
        },
        "security_kind": {
          "$ref": "#/$defs/nullableSecurityKind"
        },
        "board_lot_quantity": {
          "$ref": "#/$defs/nullablePositiveIntegerString"
        },
        "tick_rule": {
          "$ref": "#/$defs/nullableTickRule"
        },
        "admissible_for_construction": {
          "type": "boolean"
        },
        "missing_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "security_id",
              "issuer_id",
              "corporate_group_id",
              "sector_id",
              "theme_ids",
              "effective_interval",
              "venue",
              "currency",
              "security_kind",
              "board_lot_quantity",
              "tick_rule",
              "provenance.security_master",
              "provenance.theme_membership",
              "provenance.trading_rule"
            ]
          }
        },
        "reason_codes": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/reasonCodes"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classification_status": {
                "const": "COMPLETE"
              }
            },
            "required": [
              "classification_status"
            ]
          },
          "then": {
            "properties": {
              "security_id": {
                "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
              },
              "issuer_id": {
                "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
              },
              "corporate_group_id": {
                "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
              },
              "sector_id": {
                "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
              },
              "effective_interval": {
                "$ref": "#/$defs/effectiveInterval"
              },
              "venue": {
                "const": "XASX"
              },
              "currency": {
                "const": "AUD"
              },
              "security_kind": {
                "enum": [
                  "au_equity",
                  "etf",
                  "lic",
                  "reit",
                  "hybrid"
                ]
              },
              "board_lot_quantity": {
                "$ref": "evaluator-common-v1.schema.json#/$defs/positiveIntegerString"
              },
              "tick_rule": {
                "$ref": "#/$defs/tickRule"
              },
              "admissible_for_construction": {
                "const": true
              },
              "missing_fields": {
                "maxItems": 0
              },
              "reason_codes": {
                "maxItems": 0
              },
              "provenance": {
                "properties": {
                  "security_master": {
                    "$ref": "#/$defs/securityMasterProvenanceRef"
                  },
                  "theme_membership": {
                    "$ref": "#/$defs/themeMembershipProvenanceRef"
                  },
                  "trading_rule": {
                    "$ref": "#/$defs/tradingRuleProvenanceRef"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification_status": {
                "const": "INCOMPLETE"
              }
            },
            "required": [
              "classification_status"
            ]
          },
          "then": {
            "properties": {
              "admissible_for_construction": {
                "const": false
              },
              "missing_fields": {
                "minItems": 1
              },
              "reason_codes": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_mode",
        "immutable",
        "read_only",
        "non_executable",
        "market_access",
        "live_holdings_write",
        "authority_payload_embedded",
        "missing_value_inference",
        "predictive_model_input_permitted"
      ],
      "properties": {
        "evaluation_mode": {
          "const": "PAPER_ONLY"
        },
        "immutable": {
          "const": true
        },
        "read_only": {
          "const": true
        },
        "non_executable": {
          "const": true
        },
        "market_access": {
          "const": "ABSENT"
        },
        "live_holdings_write": {
          "const": false
        },
        "authority_payload_embedded": {
          "const": false
        },
        "missing_value_inference": {
          "const": false
        },
        "predictive_model_input_permitted": {
          "const": false
        }
      }
    }
  }
}
