{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asxos.local/schemas/accounting-policy-v1.schema.json",
  "title": "ASXOS Accounting Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "schema_version",
    "producer_version",
    "data_as_of",
    "created_at",
    "source_hashes",
    "accounting_policy_id",
    "accounting_policy_version",
    "effective_from",
    "scope",
    "settlement",
    "lot_and_tax",
    "corporate_actions",
    "currency",
    "chart_of_accounts",
    "rounding",
    "completeness",
    "canonical_hash",
    "controls"
  ],
  "properties": {
    "contract_name": {
      "const": "accounting-policy-v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "producer_version": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/version"
    },
    "data_as_of": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "source_hashes": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/sourceHashes"
    },
    "canonical_hash": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/canonicalHash"
    },
    "accounting_policy_id": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
    },
    "accounting_policy_version": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/version"
    },
    "effective_from": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "venue",
        "reporting_currency",
        "tax_output_class",
        "branch_tax_state"
      ],
      "properties": {
        "environment": {
          "const": "PAPER_ONLY"
        },
        "venue": {
          "const": "XASX"
        },
        "reporting_currency": {
          "const": "AUD"
        },
        "tax_output_class": {
          "const": "POINT_IN_TIME_ESTIMATE_NOT_RETURN"
        },
        "branch_tax_state": {
          "const": "ISOLATED_COUNTERFACTUAL"
        }
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trade_date_recognition",
        "cash_reservation",
        "settlement_calendar_ref",
        "position_available_on",
        "failed_settlement_action"
      ],
      "properties": {
        "trade_date_recognition": {
          "const": "RECEIVABLE_PAYABLE"
        },
        "cash_reservation": {
          "const": "AT_ORDER_ACCEPTANCE"
        },
        "settlement_calendar_ref": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
        },
        "position_available_on": {
          "const": "SETTLEMENT_COMPLETION"
        },
        "failed_settlement_action": {
          "const": "BLOCK_BRANCH_AND_RECONCILE"
        }
      }
    },
    "lot_and_tax": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lot_selection",
        "tax_profile_selection",
        "realized_tax",
        "deferred_tax",
        "loss_carryforward",
        "tax_year_boundary",
        "franking_eligibility",
        "unsupported_tax_action"
      ],
      "properties": {
        "lot_selection": {
          "enum": [
            "FIFO",
            "LIFO",
            "MIN_CGT"
          ]
        },
        "tax_profile_selection": {
          "const": "JAMES_SUPPLIED_EFFECTIVE_AT_EVENT"
        },
        "realized_tax": {
          "const": "POST_AS_PAYABLE_ON_RECOGNITION"
        },
        "deferred_tax": {
          "const": "MARK_UNREALIZED_AT_FROZEN_EFFECTIVE_RATE"
        },
        "loss_carryforward": {
          "const": "BRANCH_ISOLATED_YEAR_LEDGER"
        },
        "tax_year_boundary": {
          "const": "AUSTRALIA_30_JUNE"
        },
        "franking_eligibility": {
          "const": "REQUIRE_KNOWN_ENTITLEMENT_AND_PROFILE"
        },
        "unsupported_tax_action": {
          "const": "UNAVAILABLE_NO_ZERO_FALLBACK"
        }
      }
    },
    "corporate_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported",
        "unsupported_action"
      ],
      "properties": {
        "supported": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "SPLIT",
              "CONSOLIDATION",
              "CASH_DIVIDEND",
              "KNOWN_FRANKING",
              "SUPPORTED_RETURN_OF_CAPITAL",
              "KNOWN_CASH_DISTRIBUTION",
              "COMPLETE_CASH_DELISTING"
            ]
          }
        },
        "unsupported_action": {
          "const": "BLOCK_AND_QUEUE"
        }
      }
    },
    "currency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_translation",
        "daily_nav_translation",
        "realized_unrealized_separation",
        "missing_fx"
      ],
      "properties": {
        "transaction_translation": {
          "const": "RATE_AVAILABLE_AT_EFFECTIVE_EVENT"
        },
        "daily_nav_translation": {
          "const": "POINT_IN_TIME_AS_OF_RATE"
        },
        "realized_unrealized_separation": {
          "const": true
        },
        "missing_fx": {
          "const": "UNAVAILABLE"
        }
      }
    },
    "chart_of_accounts": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {
        "enum": [
          "CASH",
          "CASH_RESERVED",
          "POSITION_UNITS",
          "POSITION_COST_BASIS",
          "TRADE_RECEIVABLE",
          "TRADE_PAYABLE",
          "DIVIDEND_RECEIVABLE",
          "FEE_EXPENSE",
          "STRESS_COST_EXPENSE",
          "REALIZED_TAX_PAYABLE",
          "DEFERRED_TAX_LIABILITY",
          "EXTERNAL_FLOW",
          "REALIZED_GAIN_LOSS",
          "UNREALIZED_GAIN_LOSS",
          "FX_GAIN_LOSS"
        ]
      }
    },
    "rounding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "working_precision",
        "persisted_scale",
        "mode",
        "round_only_at_posting_boundary"
      ],
      "properties": {
        "working_precision": {
          "const": "DECIMAL_34"
        },
        "persisted_scale": {
          "const": "6"
        },
        "mode": {
          "const": "ROUND_HALF_EVEN"
        },
        "round_only_at_posting_boundary": {
          "const": true
        }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_classes",
        "missing_action"
      ],
      "properties": {
        "required_classes": {
          "type": "array",
          "minItems": 9,
          "uniqueItems": true,
          "items": {
            "enum": [
              "PRICE",
              "FX",
              "CORPORATE_ACTION",
              "FEE",
              "COST",
              "TAX",
              "ACCOUNTING",
              "SETTLEMENT",
              "RECONCILIATION",
              "EXTERNAL_FLOW"
            ]
          }
        },
        "missing_action": {
          "const": "BLOCK_NAV_OUTCOME_AND_GATE"
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "non_executable",
        "live_holdings_write",
        "fail_closed"
      ],
      "properties": {
        "non_executable": {
          "const": true
        },
        "live_holdings_write": {
          "const": false
        },
        "fail_closed": {
          "const": true
        }
      }
    }
  }
}
