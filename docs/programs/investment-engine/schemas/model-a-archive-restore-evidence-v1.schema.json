{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asxos.local/schemas/model-a-archive-restore-evidence-v1.schema.json",
  "title": "ASXOS Model A Archive Restore Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "schema_version",
    "producer_version",
    "data_as_of",
    "created_at",
    "source_hashes",
    "restore_evidence_id",
    "attempt_sequence",
    "manifest_ref",
    "started_at",
    "completed_at",
    "isolated_environment_id",
    "attended_operator",
    "tool_bundle_sha256",
    "runtime_lock_sha256",
    "evidence_scope",
    "comparisons",
    "verdict",
    "reason_codes",
    "controls",
    "canonical_hash"
  ],
  "properties": {
    "contract_name": {
      "const": "model-a-archive-restore-evidence-v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "producer_version": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/version"
    },
    "data_as_of": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "source_hashes": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/sourceHashes"
    },
    "restore_evidence_id": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
    },
    "attempt_sequence": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/positiveIntegerString"
    },
    "manifest_ref": {
      "allOf": [
        {
          "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "contract_name": {
              "const": "model-a-archive-manifest-v1"
            }
          }
        }
      ]
    },
    "started_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "completed_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "isolated_environment_id": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
    },
    "attended_operator": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
    },
    "tool_bundle_sha256": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
    },
    "runtime_lock_sha256": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
    },
    "evidence_scope": {
      "enum": [
        "SYNTHETIC_GOLDEN",
        "ATTENDED_REPRODUCTION"
      ]
    },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/comparison"
      }
    },
    "verdict": {
      "enum": [
        "PASS",
        "NOT_READY",
        "FAIL"
      ]
    },
    "reason_codes": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/reasonCodes"
    },
    "controls": {
      "$ref": "#/$defs/controls"
    },
    "canonical_hash": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/canonicalHash"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "PASS"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "comparisons": {
            "minItems": 8,
            "maxItems": 8,
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/comparison"
                },
                {
                  "properties": {
                    "count_match": {
                      "const": true
                    },
                    "range_match": {
                      "const": true
                    },
                    "raw_hash_match": {
                      "const": true
                    },
                    "canonical_hash_match": {
                      "const": true
                    },
                    "comparison_result": {
                      "const": "MATCH"
                    },
                    "reason_codes": {
                      "maxItems": 0
                    }
                  }
                }
              ]
            }
          },
          "reason_codes": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "enum": [
              "NOT_READY",
              "FAIL"
            ]
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_scope": {
            "const": "SYNTHETIC_GOLDEN"
          }
        },
        "required": [
          "evidence_scope"
        ]
      },
      "then": {
        "properties": {
          "controls": {
            "properties": {
              "production_evidence_claimed": {
                "const": false
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_class_id",
        "dataset_or_artifact_class",
        "observed_record_count",
        "observed_file_count",
        "observed_raw_byte_count",
        "observed_range",
        "observed_raw_sha256",
        "observed_canonical_sha256",
        "count_match",
        "range_match",
        "raw_hash_match",
        "canonical_hash_match",
        "comparison_result",
        "reason_codes"
      ],
      "properties": {
        "archive_class_id": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
        },
        "dataset_or_artifact_class": {
          "$ref": "model-a-archive-manifest-v1.schema.json#/$defs/archiveClassName"
        },
        "observed_record_count": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeIntegerString"
        },
        "observed_file_count": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeIntegerString"
        },
        "observed_raw_byte_count": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeIntegerString"
        },
        "observed_range": {
          "$ref": "model-a-archive-manifest-v1.schema.json#/$defs/observedRange"
        },
        "observed_raw_sha256": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
        },
        "observed_canonical_sha256": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
        },
        "count_match": {
          "type": "boolean"
        },
        "range_match": {
          "type": "boolean"
        },
        "raw_hash_match": {
          "type": "boolean"
        },
        "canonical_hash_match": {
          "type": "boolean"
        },
        "comparison_result": {
          "enum": [
            "MATCH",
            "MISMATCH",
            "INCOMPLETE"
          ]
        },
        "reason_codes": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/reasonCodes"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "comparison_result": {
                "const": "MATCH"
              }
            },
            "required": [
              "comparison_result"
            ]
          },
          "then": {
            "properties": {
              "count_match": {
                "const": true
              },
              "range_match": {
                "const": true
              },
              "raw_hash_match": {
                "const": true
              },
              "canonical_hash_match": {
                "const": true
              },
              "reason_codes": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "comparison_result": {
                "enum": [
                  "MISMATCH",
                  "INCOMPLETE"
                ]
              }
            },
            "required": [
              "comparison_result"
            ]
          },
          "then": {
            "properties": {
              "reason_codes": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attended",
        "isolated",
        "production_environment",
        "read_only",
        "production_write",
        "archive_write",
        "archive_mutation",
        "destructive_action",
        "runtime_shutdown_claimed",
        "production_evidence_claimed",
        "runtime_retirement_approval_claimed",
        "non_executable"
      ],
      "properties": {
        "attended": {
          "const": true
        },
        "isolated": {
          "const": true
        },
        "production_environment": {
          "const": false
        },
        "read_only": {
          "const": true
        },
        "production_write": {
          "const": false
        },
        "archive_write": {
          "const": false
        },
        "archive_mutation": {
          "const": false
        },
        "destructive_action": {
          "const": false
        },
        "runtime_shutdown_claimed": {
          "const": false
        },
        "production_evidence_claimed": {
          "type": "boolean"
        },
        "runtime_retirement_approval_claimed": {
          "const": false
        },
        "non_executable": {
          "const": true
        }
      }
    }
  }
}
