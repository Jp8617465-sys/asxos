{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asxos.local/schemas/evaluator-config-v1.schema.json",
  "title": "ASXOS Evaluator Config v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "schema_version",
    "producer_version",
    "data_as_of",
    "created_at",
    "source_hashes",
    "config_id",
    "config_version",
    "candidate_family",
    "candidate_versions",
    "policy_refs",
    "origin_schedule",
    "branches",
    "statistical_protocol",
    "model_a_isolation",
    "frozen_at",
    "canonical_hash",
    "controls"
  ],
  "properties": {
    "contract_name": {
      "const": "evaluator-config-v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "producer_version": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/version"
    },
    "data_as_of": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "source_hashes": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/sourceHashes"
    },
    "canonical_hash": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/canonicalHash"
    },
    "config_id": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
    },
    "config_version": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/version"
    },
    "candidate_family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "registration_id",
        "trial_registry_sha256",
        "registered_candidate_count",
        "selection_events_permitted"
      ],
      "properties": {
        "family_id": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
        },
        "registration_id": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
        },
        "trial_registry_sha256": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
        },
        "registered_candidate_count": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/positiveIntegerString"
        },
        "selection_events_permitted": {
          "const": false
        }
      }
    },
    "candidate_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "construction_version",
        "risk_version",
        "sizing_version",
        "staging_version",
        "fill_version",
        "cost_version",
        "tax_version",
        "accounting_version",
        "calendar_version",
        "benchmark_version",
        "evaluator_version",
        "schema_bundle_version",
        "decimal_context_version",
        "code_version",
        "runtime_lock_sha256"
      ],
      "properties": {
        "construction_version": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/version"
        },
        "risk_version": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/version"
        },
        "sizing_version": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/version"
        },
        "staging_version": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/version"
        },
        "fill_version": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/version"
        },
        "cost_version": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/version"
        },
        "tax_version": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/version"
        },
        "accounting_version": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/version"
        },
        "calendar_version": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/version"
        },
        "benchmark_version": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/version"
        },
        "evaluator_version": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/version"
        },
        "schema_bundle_version": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/version"
        },
        "decimal_context_version": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/version"
        },
        "code_version": {
          "type": "string",
          "pattern": "^[a-f0-9]{7,64}$"
        },
        "runtime_lock_sha256": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "policy_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "construction_policy_ref",
        "risk_policy_ref",
        "sizing_policy_ref",
        "staging_policy_ref",
        "fill_model_ref",
        "tax_policy_ref",
        "accounting_policy_ref",
        "calendar_ref",
        "benchmark_policy_ref",
        "evaluation_policy_ref"
      ],
      "properties": {
        "construction_policy_ref": {
          "allOf": [
            {
              "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
            },
            {
              "properties": {
                "contract_name": {
                  "const": "portfolio-construction-policy-v1"
                }
              }
            }
          ]
        },
        "risk_policy_ref": {
          "allOf": [
            {
              "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
            },
            {
              "properties": {
                "contract_name": {
                  "const": "risk-policy-v1"
                }
              }
            }
          ]
        },
        "sizing_policy_ref": {
          "allOf": [
            {
              "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
            },
            {
              "properties": {
                "contract_name": {
                  "const": "sizing-policy-v1"
                }
              }
            }
          ]
        },
        "staging_policy_ref": {
          "allOf": [
            {
              "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
            },
            {
              "properties": {
                "contract_name": {
                  "const": "staging-policy-v1"
                }
              }
            }
          ]
        },
        "fill_model_ref": {
          "allOf": [
            {
              "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
            },
            {
              "properties": {
                "contract_name": {
                  "const": "fill-model-v1"
                }
              }
            }
          ]
        },
        "tax_policy_ref": {
          "allOf": [
            {
              "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
            },
            {
              "properties": {
                "contract_name": {
                  "const": "tax-profile-v1"
                }
              }
            }
          ]
        },
        "accounting_policy_ref": {
          "allOf": [
            {
              "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
            },
            {
              "properties": {
                "contract_name": {
                  "const": "accounting-policy-v1"
                }
              }
            }
          ]
        },
        "calendar_ref": {
          "allOf": [
            {
              "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
            },
            {
              "properties": {
                "contract_name": {
                  "const": "trading-calendar-v1"
                }
              }
            }
          ]
        },
        "benchmark_policy_ref": {
          "allOf": [
            {
              "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
            },
            {
              "properties": {
                "contract_name": {
                  "const": "benchmark-policy-v1"
                }
              }
            }
          ]
        },
        "evaluation_policy_ref": {
          "allOf": [
            {
              "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
            },
            {
              "properties": {
                "contract_name": {
                  "const": "evaluation-policy-v1"
                }
              }
            }
          ]
        }
      }
    },
    "origin_schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schedule_id",
        "schedule_type",
        "cadence",
        "primary_horizon_sessions",
        "origin_registration",
        "overlap_policy",
        "dependency_group_rule",
        "retained_statuses"
      ],
      "properties": {
        "schedule_id": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
        },
        "schedule_type": {
          "const": "PROSPECTIVE_TRADING_SESSION"
        },
        "cadence": {
          "enum": [
            "EVERY_COMPLETE_SESSION",
            "PRE_REGISTERED_EVENT"
          ]
        },
        "primary_horizon_sessions": {
          "const": "63"
        },
        "origin_registration": {
          "const": "BEFORE_OUTCOME"
        },
        "overlap_policy": {
          "const": "ALLOWED_WHEN_DECLARED"
        },
        "dependency_group_rule": {
          "const": "SHARED_HORIZON_SESSION_TRANSITIVE_CLOSURE"
        },
        "retained_statuses": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "OPEN",
              "BLOCKED",
              "REJECTED",
              "NO_ACTION",
              "INVALID",
              "MATURED",
              "UNAVAILABLE"
            ]
          }
        }
      }
    },
    "branches": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "properties": {
              "branch_id": {
                "const": "PROPOSAL_BASE"
              }
            },
            "required": [
              "branch_id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "branch_id": {
                "const": "PROPOSAL_STRESS"
              }
            },
            "required": [
              "branch_id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "branch_id": {
                "const": "HOLD"
              }
            },
            "required": [
              "branch_id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "branch_id": {
                "const": "XJO_TR"
              }
            },
            "required": [
              "branch_id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "branch_id": {
                "const": "CASH"
              }
            },
            "required": [
              "branch_id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "branch_id",
          "decision_policy",
          "fill_cost_scenario",
          "external_flow_policy"
        ],
        "properties": {
          "branch_id": {
            "$ref": "evaluator-common-v1.schema.json#/$defs/branchId"
          },
          "decision_policy": {
            "enum": [
              "PROPOSAL",
              "NO_DISCRETIONARY_TRADE",
              "INDEX_TOTAL_RETURN",
              "CASH_ONLY"
            ]
          },
          "fill_cost_scenario": {
            "enum": [
              "BASE",
              "STRESS",
              "NOT_APPLICABLE"
            ]
          },
          "external_flow_policy": {
            "const": "IDENTICAL_TIMING_AND_AMOUNT"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "branch_id": {
                  "const": "PROPOSAL_BASE"
                }
              },
              "required": [
                "branch_id"
              ]
            },
            "then": {
              "properties": {
                "decision_policy": {
                  "const": "PROPOSAL"
                },
                "fill_cost_scenario": {
                  "const": "BASE"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "branch_id": {
                  "const": "PROPOSAL_STRESS"
                }
              },
              "required": [
                "branch_id"
              ]
            },
            "then": {
              "properties": {
                "decision_policy": {
                  "const": "PROPOSAL"
                },
                "fill_cost_scenario": {
                  "const": "STRESS"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "branch_id": {
                  "const": "HOLD"
                }
              },
              "required": [
                "branch_id"
              ]
            },
            "then": {
              "properties": {
                "decision_policy": {
                  "const": "NO_DISCRETIONARY_TRADE"
                },
                "fill_cost_scenario": {
                  "const": "NOT_APPLICABLE"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "branch_id": {
                  "const": "XJO_TR"
                }
              },
              "required": [
                "branch_id"
              ]
            },
            "then": {
              "properties": {
                "decision_policy": {
                  "const": "INDEX_TOTAL_RETURN"
                },
                "fill_cost_scenario": {
                  "const": "NOT_APPLICABLE"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "branch_id": {
                  "const": "CASH"
                }
              },
              "required": [
                "branch_id"
              ]
            },
            "then": {
              "properties": {
                "decision_policy": {
                  "const": "CASH_ONLY"
                },
                "fill_cost_scenario": {
                  "const": "NOT_APPLICABLE"
                }
              }
            }
          }
        ]
      }
    },
    "statistical_protocol": {
      "$ref": "#/$defs/statisticalProtocol"
    },
    "model_a_isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structural_dependency",
        "required_test",
        "evidence_ref_required"
      ],
      "properties": {
        "structural_dependency": {
          "const": "ABSENT"
        },
        "required_test": {
          "const": "REMOVAL_AND_RANDOMIZATION_BYTE_IDENTICAL"
        },
        "evidence_ref_required": {
          "const": true
        }
      }
    },
    "frozen_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_mode",
        "non_executable",
        "simulated_fills_only",
        "prospective_only",
        "broker_capability",
        "live_holdings_write"
      ],
      "properties": {
        "evaluation_mode": {
          "const": "PAPER_ONLY"
        },
        "non_executable": {
          "const": true
        },
        "simulated_fills_only": {
          "const": true
        },
        "prospective_only": {
          "const": true
        },
        "broker_capability": {
          "const": "ABSENT"
        },
        "live_holdings_write": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "statisticalProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_estimand",
        "primary_branch",
        "comparisons",
        "statistic",
        "resampling_unit",
        "bootstrap_method",
        "block_rule",
        "primary_block_length_sessions",
        "sensitivity_block_lengths",
        "block_boundary",
        "circular_index_rule",
        "terminal_block_rule",
        "minimum_clean_paired_sessions",
        "session_order",
        "common_endpoint_rule",
        "repetitions",
        "seed_derivation",
        "seed_bit_width",
        "seed_byte_order",
        "prng_id",
        "numpy_version",
        "draw_mapping",
        "interval_estimator",
        "percentile_rule",
        "one_sided_confidence",
        "sensitivity_interval_estimator",
        "sensitivity_two_sided_confidence",
        "missingness_policy",
        "decimal_output_scale",
        "candidate_family_required",
        "multiple_testing_method"
      ],
      "properties": {
        "primary_estimand": {
          "const": "CONTINUOUS_STRESS_AFTER_TAX_ESTIMATE_DAILY_LOG_ACTIVE_RETURN"
        },
        "primary_branch": {
          "const": "PROPOSAL_STRESS"
        },
        "comparisons": {
          "const": [
            "HOLD",
            "XJO_TR"
          ]
        },
        "statistic": {
          "const": "ANNUALISED_PAIRED_LOG_ACTIVE_RETURN_252"
        },
        "resampling_unit": {
          "const": "PAIRED_DAILY_RETURN_TUPLE"
        },
        "bootstrap_method": {
          "const": "CIRCULAR_MOVING_BLOCK_BOOTSTRAP"
        },
        "block_rule": {
          "const": "FIXED_PRE_REGISTERED"
        },
        "primary_block_length_sessions": {
          "const": "10"
        },
        "sensitivity_block_lengths": {
          "const": [
            "5",
            "20"
          ]
        },
        "block_boundary": {
          "const": "CIRCULAR"
        },
        "circular_index_rule": {
          "const": "SOURCE_INDEX_MODULO_N"
        },
        "terminal_block_rule": {
          "const": "CONCATENATE_THEN_TRUNCATE_TO_N"
        },
        "minimum_clean_paired_sessions": {
          "const": "252"
        },
        "session_order": {
          "const": "ASCENDING_TRADING_SESSION"
        },
        "common_endpoint_rule": {
          "const": "COMPLETE_STRESS_AND_COMPARATOR_SAME_SESSION"
        },
        "repetitions": {
          "const": "100000"
        },
        "seed_derivation": {
          "const": "UNSIGNED_FIRST_128_BITS_SHA256_COHORT_ID_PIPE_METRIC_ID_PIPE_EVALUATION_POLICY_SHA256"
        },
        "seed_bit_width": {
          "const": "128"
        },
        "seed_byte_order": {
          "const": "BIG_ENDIAN"
        },
        "prng_id": {
          "const": "NUMPY_PCG64DXSM"
        },
        "numpy_version": {
          "const": "2.1.1"
        },
        "draw_mapping": {
          "const": "NUMPY_GENERATOR_INTEGERS_0_TO_N_EXCLUSIVE"
        },
        "interval_estimator": {
          "const": "EMPIRICAL_TYPE_1"
        },
        "percentile_rule": {
          "const": "NEAREST_RANK_10TH_PERCENTILE"
        },
        "one_sided_confidence": {
          "const": "0.900000"
        },
        "sensitivity_interval_estimator": {
          "const": "EMPIRICAL_TYPE_1"
        },
        "sensitivity_two_sided_confidence": {
          "const": "0.950000"
        },
        "missingness_policy": {
          "const": "DIRTY_SESSION_RESETS_OPERATIONAL_STREAK_NO_IMPUTATION"
        },
        "decimal_output_scale": {
          "const": "6"
        },
        "candidate_family_required": {
          "const": true
        },
        "multiple_testing_method": {
          "const": "HOLM_FAMILYWISE_DIAGNOSTIC"
        }
      }
    }
  }
}
