{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asxos.local/schemas/paper-order-v1.schema.json",
  "title": "ASXOS Paper Order v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "schema_version",
    "producer_version",
    "data_as_of",
    "created_at",
    "source_hashes",
    "paper_order_id",
    "origin_ref",
    "intent_ref",
    "fill_model_ref",
    "branch_id",
    "asset_id",
    "side",
    "order_type",
    "quantity",
    "limit_price_aud",
    "tick_size_aud",
    "board_lot_quantity",
    "knowledge_cutoff",
    "intent_recorded_at",
    "order_recorded_at",
    "first_eligible_market_event_at",
    "expires_at",
    "max_volume_participation",
    "state",
    "canonical_hash",
    "controls"
  ],
  "properties": {
    "contract_name": {
      "const": "paper-order-v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "producer_version": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/version"
    },
    "data_as_of": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "source_hashes": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/sourceHashes"
    },
    "canonical_hash": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/canonicalHash"
    },
    "paper_order_id": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
    },
    "origin_ref": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
    },
    "intent_ref": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
    },
    "fill_model_ref": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
    },
    "branch_id": {
      "enum": [
        "PROPOSAL_BASE",
        "PROPOSAL_STRESS"
      ]
    },
    "asset_id": {
      "type": "string",
      "pattern": "^XASX:[A-Z0-9]{3,6}$"
    },
    "side": {
      "enum": [
        "BUY",
        "SELL"
      ]
    },
    "order_type": {
      "const": "LIMIT"
    },
    "quantity": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/positiveIntegerString"
    },
    "limit_price_aud": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/positiveDecimal6"
    },
    "tick_size_aud": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/positiveDecimal6"
    },
    "board_lot_quantity": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/positiveIntegerString"
    },
    "knowledge_cutoff": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "intent_recorded_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "order_recorded_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "first_eligible_market_event_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "max_volume_participation": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/unitDecimal6"
    },
    "state": {
      "enum": [
        "RECORDED",
        "ELIGIBLE",
        "PARTIALLY_FILLED",
        "FILLED",
        "EXPIRED",
        "CANCELLED_BY_PROTOCOL"
      ]
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_mode",
        "simulated",
        "non_executable",
        "same_session_fill_allowed",
        "broker_capability"
      ],
      "properties": {
        "evaluation_mode": {
          "const": "PAPER_ONLY"
        },
        "simulated": {
          "const": true
        },
        "non_executable": {
          "const": true
        },
        "same_session_fill_allowed": {
          "const": false
        },
        "broker_capability": {
          "const": "ABSENT"
        }
      }
    }
  }
}
