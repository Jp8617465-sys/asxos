{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asxos.local/schemas/sizing-decision-v1.schema.json",
  "title": "ASXOS Sizing Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "schema_version",
    "producer",
    "sizing_decision_id",
    "investment_case_id",
    "portfolio_id",
    "lineage",
    "construction_policy_ref",
    "proposal_ref",
    "risk_policy_ref",
    "sizing_policy_ref",
    "portfolio_snapshot_ref",
    "classification_snapshot_ref",
    "status",
    "eligible_for_staging",
    "data_as_of",
    "knowledge_cutoff",
    "decision_at",
    "created_at",
    "source_hashes",
    "line_items",
    "summary",
    "reason_codes",
    "controls",
    "canonical_hash"
  ],
  "properties": {
    "contract_name": {
      "const": "sizing-decision-v1"
    },
    "schema_version": {
      "const": "1.1.0"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "sizing_decision_id": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
    },
    "investment_case_id": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
    },
    "portfolio_id": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
    },
    "lineage": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/caseLineage"
    },
    "construction_policy_ref": {
      "oneOf": [
        {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/versionedRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposal_ref": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/hashRef"
    },
    "risk_policy_ref": {
      "oneOf": [
        {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/versionedRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "sizing_policy_ref": {
      "oneOf": [
        {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/versionedRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "portfolio_snapshot_ref": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/hashRef"
    },
    "classification_snapshot_ref": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
            },
            {
              "properties": {
                "contract_name": {
                  "const": "security-classification-snapshot-v1"
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "SIZED",
        "REJECTED_NO_POLICY",
        "REJECTED_POLICY_VIOLATION"
      ]
    },
    "eligible_for_staging": {
      "type": "boolean"
    },
    "data_as_of": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
    },
    "knowledge_cutoff": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
    },
    "decision_at": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
    },
    "source_hashes": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/sourceHashes"
    },
    "line_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lineItem"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      }
    },
    "controls": {
      "$ref": "#/$defs/controls"
    },
    "canonical_hash": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/canonicalHash"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SIZED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "construction_policy_ref": {
            "$ref": "investment-case-lineage-v1.schema.json#/$defs/versionedRef"
          },
          "risk_policy_ref": {
            "$ref": "investment-case-lineage-v1.schema.json#/$defs/versionedRef"
          },
          "sizing_policy_ref": {
            "$ref": "investment-case-lineage-v1.schema.json#/$defs/versionedRef"
          },
          "eligible_for_staging": {
            "const": true
          },
          "lineage": {
            "properties": {
              "lineage_stage": {
                "const": "PROPOSAL_BUILT"
              },
              "case_state": {
                "const": "SHADOW_ACTIVE"
              },
              "sizing_decision_ref": {
                "type": "null"
              }
            }
          },
          "line_items": {
            "minItems": 1
          },
          "reason_codes": {
            "maxItems": 0
          },
          "classification_snapshot_ref": {
            "allOf": [
              {
                "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
              },
              {
                "properties": {
                  "contract_name": {
                    "const": "security-classification-snapshot-v1"
                  }
                }
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "eligible_for_staging": {
            "const": false
          },
          "line_items": {
            "maxItems": 0
          },
          "reason_codes": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "REJECTED_NO_POLICY"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "lineage": {
            "properties": {
              "lineage_stage": {
                "const": "EVALUATION_FROZEN"
              }
            }
          },
          "reason_codes": {
            "contains": {
              "enum": [
                "MISSING_CONSTRUCTION_POLICY",
                "MISSING_RISK_POLICY",
                "MISSING_SIZING_POLICY",
                "AMBIGUOUS_EFFECTIVE_POLICY"
              ]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "REJECTED_POLICY_VIOLATION"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "lineage": {
            "properties": {
              "lineage_stage": {
                "const": "PROPOSAL_BUILT"
              }
            }
          },
          "construction_policy_ref": {
            "$ref": "investment-case-lineage-v1.schema.json#/$defs/versionedRef"
          },
          "risk_policy_ref": {
            "$ref": "investment-case-lineage-v1.schema.json#/$defs/versionedRef"
          },
          "sizing_policy_ref": {
            "$ref": "investment-case-lineage-v1.schema.json#/$defs/versionedRef"
          }
        }
      }
    }
  ],
  "$defs": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_type",
        "method",
        "producer_version",
        "code_version"
      ],
      "properties": {
        "producer_type": {
          "const": "DETERMINISTIC_QUANT"
        },
        "method": {
          "const": "POLICY_CAPPED_BOARD_LOT"
        },
        "producer_version": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/version"
        },
        "code_version": {
          "type": "string",
          "pattern": "^[a-f0-9]{7,64}$"
        }
      }
    },
    "lineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line_id",
        "line_item_sha256",
        "asset_id",
        "security_id",
        "issuer_id",
        "corporate_group_id",
        "sector_id",
        "theme_ids",
        "tick_rule_ref",
        "tick_size_aud",
        "proposal_target_sha256",
        "side",
        "current_weight",
        "target_weight",
        "requested_delta_weight",
        "reference_price_aud",
        "board_lot_quantity",
        "requested_quantity",
        "approved_quantity",
        "requested_notional_aud",
        "approved_notional_aud",
        "estimated_fees_aud",
        "decision",
        "constraint_checks"
      ],
      "properties": {
        "line_id": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
