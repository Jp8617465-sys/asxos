            {
              "contains": {
                "properties": {
                  "constraint_code": {
                    "const": "GROSS_EXPOSURE"
                  }
                },
                "required": [
                  "constraint_code"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "constraint_code": {
                    "const": "NET_EXPOSURE"
                  }
                },
                "required": [
                  "constraint_code"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "constraint_code": {
