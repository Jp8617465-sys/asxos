              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "constraint_code": {
                    "const": "SECTOR"
                  }
                },
                "required": [
                  "constraint_code"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "constraint_code": {
                    "const": "THEME"
                  }
                },
                "required": [
                  "constraint_code"
