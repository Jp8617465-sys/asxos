                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "constraint_code": {
                    "const": "TARGET_NOTIONAL"
                  }
                },
                "required": [
                  "constraint_code"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "constraint_code": {
                    "const": "AVAILABLE_CASH"
                  }
                },
                "required": [
                  "constraint_code"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "constraint_code": {
                    "const": "ISSUER"
                  }
                },
                "required": [
                  "constraint_code"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "constraint_code": {
                    "const": "CORPORATE_GROUP"
                  }
                },
                "required": [
                  "constraint_code"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "constraint_code": {
                    "const": "SINGLE_NAME"
                  }
                },
                "required": [
                  "constraint_code"
                ]
