                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/constraintCheck"
                },
                {
                  "properties": {
                    "sequence": {
                      "const": 20
                    },
                    "constraint_code": {
                      "const": "FEES"
                    }
                  }
                }
              ]
            }
          ],
          "items": {
            "$ref": "#/$defs/constraintCheck"
          }
        }
      }
    },
