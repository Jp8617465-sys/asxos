{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asxos.local/schemas/portfolio-proposal-v1.schema.json",
  "title": "Portfolio Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "schema_version",
    "producer",
    "proposal_id",
    "investment_case_id",
    "portfolio_id",
    "lineage",
    "construction_policy_ref",
    "risk_policy_ref",
    "classification_snapshot_ref",
    "status",
    "eligible_for_sizing",
    "data_as_of",
    "knowledge_cutoff",
    "decision_at",
    "created_at",
    "source_hashes",
    "input_manifest",
    "portfolio_snapshot",
    "candidate_inputs",
    "targets",
    "summary",
    "reason_codes",
    "controls",
    "canonical_hash"
  ],
  "properties": {
    "contract_name": {
      "const": "portfolio-proposal-v1"
    },
    "schema_version": {
      "const": "1.1.0"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "proposal_id": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
    },
    "investment_case_id": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
    },
    "portfolio_id": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
    },
    "lineage": {
      "allOf": [
        {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/caseLineage"
        },
        {
          "properties": {
            "lineage_stage": {
              "const": "EVALUATION_FROZEN"
            },
            "case_state": {
              "const": "SHADOW_ACTIVE"
            },
            "portfolio_proposal_ref": {
              "type": "null"
            },
            "construction_policy_ref": {
              "type": "null"
            },
            "risk_policy_ref": {
              "type": "null"
            }
          }
        }
      ]
    },
    "construction_policy_ref": {
      "oneOf": [
        {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/versionedRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "risk_policy_ref": {
      "oneOf": [
        {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/versionedRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "classification_snapshot_ref": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
            },
            {
              "properties": {
                "contract_name": {
                  "const": "security-classification-snapshot-v1"
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "BUILT",
        "HOLD_CASH",
        "REJECTED_NO_CONSTRUCTION_POLICY",
        "REJECTED_NO_RISK_POLICY",
        "REJECTED_INCOMPLETE_INPUT",
        "REJECTED_INFEASIBLE"
      ]
    },
    "eligible_for_sizing": {
      "type": "boolean"
    },
    "data_as_of": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
    },
    "knowledge_cutoff": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
    },
    "decision_at": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
    },
    "source_hashes": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/sourceHashes"
    },
    "input_manifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceObservation"
      }
    },
    "portfolio_snapshot": {
      "$ref": "#/$defs/portfolioSnapshot"
    },
    "candidate_inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidateInput"
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      }
    },
    "controls": {
      "$ref": "#/$defs/controls"
    },
    "canonical_hash": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/canonicalHash"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "BUILT"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "construction_policy_ref": {
            "$ref": "investment-case-lineage-v1.schema.json#/$defs/versionedRef"
          },
          "risk_policy_ref": {
            "$ref": "investment-case-lineage-v1.schema.json#/$defs/versionedRef"
          },
          "eligible_for_sizing": {
            "const": true
          },
          "targets": {
            "minItems": 1
          },
          "candidate_inputs": {
            "minItems": 1,
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/candidateInput"
                },
                {
                  "properties": {
                    "input_state": {
                      "const": "COMPLETE"
                    },
                    "classification_status": {
                      "const": "COMPLETE"
                    },
                    "admissible_for_construction": {
                      "const": true
                    },
                    "security_id": {
                      "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
                    },
                    "issuer_id": {
                      "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
                    },
                    "corporate_group_id": {
                      "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
                    },
                    "sector_id": {
                      "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
                    },
                    "theme_ids": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
                      }
                    },
                    "board_lot_quantity": {
                      "$ref": "investment-case-lineage-v1.schema.json#/$defs/positiveIntegerString"
                    },
                    "tick_rule_ref": {
                      "$ref": "investment-case-lineage-v1.schema.json#/$defs/versionedRef"
                    },
                    "tick_size_aud": {
                      "$ref": "investment-case-lineage-v1.schema.json#/$defs/positiveDecimal"
                    }
                  }
                }
              ]
            }
          },
          "reason_codes": {
            "maxItems": 0
          },
          "classification_snapshot_ref": {
            "allOf": [
              {
                "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
              },
              {
                "properties": {
                  "contract_name": {
                    "const": "security-classification-snapshot-v1"
                  }
                }
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "eligible_for_sizing": {
            "const": false
          },
          "targets": {
            "maxItems": 0
          },
          "reason_codes": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "REJECTED_NO_CONSTRUCTION_POLICY"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "construction_policy_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "REJECTED_NO_RISK_POLICY"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "risk_policy_ref": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_type",
        "method",
        "producer_version",
        "code_version"
      ],
      "properties": {
        "producer_type": {
          "const": "DETERMINISTIC_QUANT"
        },
        "method": {
          "const": "RISK_BUDGET_AT_STOP"
        },
        "producer_version": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/version"
        },
        "code_version": {
          "type": "string",
          "pattern": "^[a-f0-9]{7,64}$"
        }
      }
    },
    "sourceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "record_id",
        "observed_at",
        "published_at",
        "available_at",
        "content_sha256"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "record_id": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
        },
        "observed_at": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
        },
        "published_at": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
        },
        "available_at": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
        },
        "content_sha256": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "holding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "quantity",
        "market_value_aud",
        "current_weight",
        "sector_id",
        "price_as_of"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^XASX:[A-Z0-9]{3,6}$"
        },
        "quantity": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/nonNegativeIntegerString"
        },
        "market_value_aud": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/nonNegativeDecimal"
        },
        "current_weight": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/unitDecimal"
        },
        "sector_id": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
        },
        "price_as_of": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
        }
      }
    },
    "taxLot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lot_id",
        "asset_id",
        "quantity",
        "cost_base_aud",
        "acquired_at",
        "tax_result_sha256"
      ],
      "properties": {
        "lot_id": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
        },
        "asset_id": {
          "type": "string",
          "pattern": "^XASX:[A-Z0-9]{3,6}$"
        },
        "quantity": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/positiveIntegerString"
        },
        "cost_base_aud": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/nonNegativeDecimal"
        },
        "acquired_at": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
        },
        "tax_result_sha256": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "sectorExposure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sector_id",
        "current_weight"
      ],
      "properties": {
        "sector_id": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
        },
        "current_weight": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/unitDecimal"
        }
      }
    },
    "portfolioSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "as_of",
        "nav_aud",
        "cash_aud",
        "gross_weight",
        "net_weight",
        "external_flow_aud",
        "holdings",
        "tax_lots",
        "sector_exposures",
        "snapshot_sha256"
      ],
      "properties": {
        "snapshot_id": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
        },
        "as_of": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
        },
        "nav_aud": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/positiveDecimal"
        },
        "cash_aud": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/nonNegativeDecimal"
        },
        "gross_weight": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/nonNegativeDecimal"
        },
        "net_weight": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/decimal"
        },
        "external_flow_aud": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/decimal"
        },
        "holdings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/holding"
          }
        },
        "tax_lots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/taxLot"
          }
        },
        "sector_exposures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sectorExposure"
          }
        },
        "snapshot_sha256": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "candidateInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "security_id",
        "issuer_id",
        "corporate_group_id",
        "sector_id",
        "theme_ids",
        "board_lot_quantity",
        "tick_rule_ref",
        "tick_size_aud",
        "classification_status",
        "admissible_for_construction",
        "eligibility_decision_ref",
        "reference_price_aud",
        "thesis_stop_price_aud",
        "stop_distance_fraction",
        "average_daily_value_aud",
        "spread_fraction",
        "tax_consequence_aud",
        "fee_estimate_aud",
        "input_state",
        "reason_codes"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^XASX:[A-Z0-9]{3,6}$"
        },
        "security_id": {
          "oneOf": [
            {
              "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "issuer_id": {
          "oneOf": [
            {
              "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "corporate_group_id": {
          "oneOf": [
            {
              "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "sector_id": {
          "oneOf": [
            {
              "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "theme_ids": {
          "oneOf": [
            {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "board_lot_quantity": {
          "oneOf": [
            {
              "$ref": "investment-case-lineage-v1.schema.json#/$defs/positiveIntegerString"
            },
            {
              "type": "null"
            }
          ]
        },
        "tick_rule_ref": {
          "oneOf": [
            {
              "$ref": "investment-case-lineage-v1.schema.json#/$defs/versionedRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "tick_size_aud": {
          "oneOf": [
            {
              "$ref": "investment-case-lineage-v1.schema.json#/$defs/positiveDecimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "classification_status": {
          "enum": [
            "COMPLETE",
            "INCOMPLETE"
          ]
        },
        "admissible_for_construction": {
          "type": "boolean"
        },
        "eligibility_decision_ref": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/hashRef"
        },
        "reference_price_aud": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/positiveDecimal"
        },
        "thesis_stop_price_aud": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/positiveDecimal"
        },
        "stop_distance_fraction": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/unitDecimal"
        },
        "average_daily_value_aud": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/nonNegativeDecimal"
        },
        "spread_fraction": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/unitDecimal"
        },
        "tax_consequence_aud": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/decimal"
        },
        "fee_estimate_aud": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/nonNegativeDecimal"
        },
        "input_state": {
          "enum": [
            "COMPLETE",
            "INCOMPLETE",
            "STALE",
            "INELIGIBLE"
          ]
        },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "security_id",
        "issuer_id",
        "corporate_group_id",
        "sector_id",
        "theme_ids",
        "board_lot_quantity",
        "tick_rule_ref",
        "tick_size_aud",
        "current_weight",
        "stop_distance_fraction",
        "effective_stop_distance_fraction",
        "risk_budget_fraction",
        "uncapped_target_weight",
        "cap_checks",
        "target_weight",
        "requested_delta_weight",
        "expected_loss_at_stop_fraction",
        "construction_status",
        "target_sha256"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^XASX:[A-Z0-9]{3,6}$"
        },
        "security_id": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
        },
        "issuer_id": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
        },
        "corporate_group_id": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
        },
        "sector_id": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
        },
        "theme_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
          }
        },
        "board_lot_quantity": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/positiveIntegerString"
        },
        "tick_rule_ref": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/versionedRef"
        },
        "tick_size_aud": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/positiveDecimal"
        },
        "current_weight": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/unitDecimal"
        },
        "stop_distance_fraction": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/unitDecimal"
        },
        "effective_stop_distance_fraction": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/unitDecimal"
        },
        "risk_budget_fraction": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/unitDecimal"
        },
        "uncapped_target_weight": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/nonNegativeDecimal"
        },
        "cap_checks": {
          "type": "array",
          "minItems": 17,
          "maxItems": 17,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/capCheck"
                },
                {
                  "properties": {
                    "sequence": {
                      "const": 1
                    },
                    "cap_code": {
                      "const": "ELIGIBILITY"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/capCheck"
                },
                {
                  "properties": {
                    "sequence": {
                      "const": 2
                    },
                    "cap_code": {
                      "const": "CLASSIFICATION"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/capCheck"
                },
                {
                  "properties": {
                    "sequence": {
                      "const": 3
                    },
                    "cap_code": {
                      "const": "STOP_RISK"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/capCheck"
                },
                {
                  "properties": {
                    "sequence": {
                      "const": 4
                    },
                    "cap_code": {
                      "const": "ISSUER"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/capCheck"
                },
                {
                  "properties": {
                    "sequence": {
                      "const": 5
                    },
                    "cap_code": {
                      "const": "CORPORATE_GROUP"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/capCheck"
                },
                {
                  "properties": {
                    "sequence": {
                      "const": 6
                    },
