{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asxos.local/schemas/branch-nav-v1.schema.json",
  "title": "ASXOS Branch NAV v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "schema_version",
    "producer_version",
    "data_as_of",
    "created_at",
    "source_hashes",
    "nav_artifact_id",
    "origin_ref",
    "config_ref",
    "ledger_ref",
    "accounting_policy_ref",
    "benchmark_policy_ref",
    "branches",
    "canonical_hash",
    "controls"
  ],
  "properties": {
    "contract_name": {
      "const": "branch-nav-v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "producer_version": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/version"
    },
    "data_as_of": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "source_hashes": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/sourceHashes"
    },
    "canonical_hash": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/canonicalHash"
    },
    "nav_artifact_id": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
    },
    "origin_ref": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
    },
    "config_ref": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
    },
    "ledger_ref": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
    },
    "accounting_policy_ref": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
    },
    "benchmark_policy_ref": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
    },
    "branches": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "properties": {
              "branch_id": {
                "const": "PROPOSAL_BASE"
              }
            },
            "required": [
              "branch_id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "branch_id": {
                "const": "PROPOSAL_STRESS"
              }
            },
            "required": [
              "branch_id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "branch_id": {
                "const": "HOLD"
              }
            },
            "required": [
              "branch_id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "branch_id": {
                "const": "XJO_TR"
              }
            },
            "required": [
              "branch_id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "branch_id": {
                "const": "CASH"
              }
            },
            "required": [
              "branch_id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {
        "$ref": "#/$defs/branchSeries"
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_flows_are_not_return",
        "cost_and_tax_are_expenses",
        "imputation_permitted",
        "decimal_math"
      ],
      "properties": {
        "external_flows_are_not_return": {
          "const": true
        },
        "cost_and_tax_are_expenses": {
          "const": true
        },
        "imputation_permitted": {
          "const": false
        },
        "decimal_math": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "branchSeries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch_id",
        "series_status",
        "entries",
        "series_sha256",
        "missing_session_count"
      ],
      "properties": {
        "branch_id": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/branchId"
        },
        "series_status": {
          "enum": [
            "COMPLETE",
            "INCOMPLETE"
          ]
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/navEntry"
          }
        },
        "series_sha256": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
        },
        "missing_session_count": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeIntegerString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "branch_id": {
                "const": "XJO_TR"
              }
            },
            "required": [
              "branch_id"
            ]
          },
          "then": {
            "properties": {
              "entries": {
                "items": {
                  "required": [
                    "benchmark_snapshot_ref"
                  ],
                  "properties": {
                    "benchmark_snapshot_ref": {
                      "allOf": [
                        {
                          "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
                        },
                        {
                          "properties": {
                            "contract_name": {
                              "const": "benchmark-snapshot-v1"
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "series_status": {
                "const": "COMPLETE"
              }
            },
            "required": [
              "series_status"
            ]
          },
          "then": {
            "properties": {
              "entries": {
                "items": {
                  "properties": {
                    "status": {
                      "const": "COMPLETE"
                    }
                  }
                }
              },
              "missing_session_count": {
                "const": "0"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "series_status": {
                "const": "INCOMPLETE"
              }
            },
            "required": [
              "series_status"
            ]
          },
          "then": {
            "properties": {
              "entries": {
                "contains": {
                  "properties": {
                    "status": {
                      "const": "UNAVAILABLE"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "minContains": 1
              },
              "missing_session_count": {
                "$ref": "evaluator-common-v1.schema.json#/$defs/positiveIntegerString"
              }
            }
          }
        }
      ]
    },
    "navEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_date",
        "status",
        "beginning_nav_aud",
        "cash_aud",
        "positions_aud",
        "receivables_aud",
        "payables_aud",
        "accrued_fees_aud",
        "realized_tax_payable_aud",
        "deferred_tax_liability_aud",
        "ending_nav_aud",
        "external_flows_aud",
        "weighted_external_flows_aud",
        "modified_dietz_return",
        "active_log_return_vs_hold",
        "active_log_return_vs_xjo_tr",
        "source_snapshot_sha256",
        "reason_codes"
      ],
      "properties": {
        "session_date": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/date"
        },
        "status": {
          "enum": [
            "COMPLETE",
            "UNAVAILABLE"
          ]
        },
        "beginning_nav_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "cash_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "positions_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "receivables_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "payables_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "accrued_fees_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "realized_tax_payable_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "deferred_tax_liability_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "ending_nav_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "external_flows_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/decimal6"
        },
        "weighted_external_flows_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/decimal6"
        },
        "modified_dietz_return": {
          "oneOf": [
            {
              "$ref": "evaluator-common-v1.schema.json#/$defs/decimal6"
            },
            {
              "type": "null"
            }
          ]
        },
        "active_log_return_vs_hold": {
          "oneOf": [
            {
              "$ref": "evaluator-common-v1.schema.json#/$defs/decimal6"
            },
            {
              "type": "null"
            }
          ]
        },
        "active_log_return_vs_xjo_tr": {
          "oneOf": [
            {
              "$ref": "evaluator-common-v1.schema.json#/$defs/decimal6"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_snapshot_sha256": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
        },
        "benchmark_snapshot_ref": {
          "allOf": [
            {
              "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
            },
            {
              "properties": {
                "contract_name": {
                  "const": "benchmark-snapshot-v1"
                }
              }
            }
          ]
        },
        "reason_codes": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/reasonCodes"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "COMPLETE"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "modified_dietz_return": {
                "$ref": "evaluator-common-v1.schema.json#/$defs/decimal6"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "UNAVAILABLE"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "modified_dietz_return": {
                "type": "null"
              },
              "active_log_return_vs_hold": {
                "type": "null"
              },
              "active_log_return_vs_xjo_tr": {
                "type": "null"
              },
              "reason_codes": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
