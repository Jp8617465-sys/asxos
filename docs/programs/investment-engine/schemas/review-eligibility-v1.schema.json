{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asxos.local/schemas/review-eligibility-v1.schema.json",
  "title": "Review Eligibility v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "schema_version",
    "eligibility_decision_id",
    "investment_case_id",
    "review_cycle_id",
    "report_ref",
    "report_candidate_sha256",
    "context_id",
    "context_sha256",
    "assessment_refs",
    "context_state",
    "finding_summary",
    "decision",
    "reason_codes",
    "decided_at",
    "controls",
    "canonical_hash"
  ],
  "properties": {
    "contract_name": {
      "const": "review-eligibility-v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "eligibility_decision_id": {
      "type": "string",
      "format": "uuid"
    },
    "investment_case_id": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
    },
    "review_cycle_id": {
      "type": "string",
      "format": "uuid"
    },
    "report_ref": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/hashRef"
    },
    "report_candidate_sha256": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/sha256"
    },
    "context_id": {
      "type": "string",
      "format": "uuid"
    },
    "context_sha256": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/sha256"
    },
    "assessment_refs": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "allOf": [
        {
          "contains": {
            "properties": {
              "role": {
                "const": "evidence_claims"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "valuation_scenarios"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "thesis_adversary"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "portfolio_risk_fit"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "implementation_liquidity_tax"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {
        "$ref": "#/$defs/assessmentRef"
      }
    },
    "context_state": {
      "enum": [
        "COMPLETE_FRESH",
        "BLOCKED_STALE",
        "BLOCKED_INCOMPLETE",
        "BLOCKED_INVALID"
      ]
    },
    "finding_summary": {
      "$ref": "#/$defs/findingSummary"
    },
    "decision": {
      "enum": [
        "BLOCKED",
        "FAIL",
        "PAPER_ELIGIBLE"
      ]
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      }
    },
    "decided_at": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic_synthesis",
        "llm_vote_permitted",
        "confidence_weighting_permitted",
        "mandatory_abstention_blocks",
        "blind_first_passes_verified",
        "non_executable"
      ],
      "properties": {
        "deterministic_synthesis": {
          "const": true
        },
        "llm_vote_permitted": {
          "const": false
        },
        "confidence_weighting_permitted": {
          "const": false
        },
        "mandatory_abstention_blocks": {
          "const": true
        },
        "blind_first_passes_verified": {
          "const": true
        },
        "non_executable": {
          "const": true
        }
      }
    },
    "canonical_hash": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/canonicalHash"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "PAPER_ELIGIBLE"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "context_state": {
            "const": "COMPLETE_FRESH"
          },
          "assessment_refs": {
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/assessmentRef"
                },
                {
                  "properties": {
                    "verdict": {
                      "enum": [
                        "PASS",
                        "CHALLENGE"
                      ]
                    }
                  }
                }
              ]
            }
          },
          "finding_summary": {
            "properties": {
              "open_high": {
                "const": 0
              },
              "open_critical": {
                "const": 0
              },
              "abstention_count": {
                "const": 0
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "assessmentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_id",
        "assessment_sha256",
        "role",
        "verdict"
      ],
      "properties": {
        "assessment_id": {
          "type": "string",
          "format": "uuid"
        },
        "assessment_sha256": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/sha256"
        },
        "role": {
          "enum": [
            "evidence_claims",
            "valuation_scenarios",
            "thesis_adversary",
            "portfolio_risk_fit",
            "implementation_liquidity_tax"
          ]
        },
        "verdict": {
          "enum": [
            "PASS",
            "CHALLENGE",
            "FAIL",
            "ABSTAIN"
          ]
        }
      }
    },
    "findingSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open_info",
        "open_low",
        "open_medium",
        "open_high",
        "open_critical",
        "accepted_risk_count",
        "resolved_count",
        "abstention_count"
      ],
      "properties": {
        "open_info": {
          "type": "integer",
          "minimum": 0
        },
        "open_low": {
          "type": "integer",
          "minimum": 0
        },
        "open_medium": {
          "type": "integer",
          "minimum": 0
        },
        "open_high": {
          "type": "integer",
          "minimum": 0
        },
        "open_critical": {
          "type": "integer",
          "minimum": 0
        },
        "accepted_risk_count": {
          "type": "integer",
          "minimum": 0
        },
        "resolved_count": {
          "type": "integer",
          "minimum": 0
        },
        "abstention_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
