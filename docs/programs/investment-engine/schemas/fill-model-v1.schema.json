{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asxos.local/schemas/fill-model-v1.schema.json",
  "title": "ASXOS Fill Model v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "schema_version",
    "producer_version",
    "data_as_of",
    "created_at",
    "source_hashes",
    "fill_model_id",
    "fill_model_version",
    "effective_from",
    "approval",
    "data_requirements",
    "fill_rules",
    "base_costs",
    "stress_costs",
    "incomplete_action",
    "canonical_hash",
    "controls"
  ],
  "properties": {
    "contract_name": {
      "const": "fill-model-v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "producer_version": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/version"
    },
    "data_as_of": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "source_hashes": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/sourceHashes"
    },
    "canonical_hash": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/canonicalHash"
    },
    "fill_model_id": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
    },
    "fill_model_version": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/version"
    },
    "effective_from": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approved_by",
        "approved_at",
        "approval_sha256"
      ],
      "properties": {
        "status": {
          "const": "RATIFIED"
        },
        "approved_by": {
          "const": "James"
        },
        "approved_at": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
        },
        "approval_sha256": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "data_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferred_market_data",
        "daily_bar_fallback",
        "volume_required",
        "quote_max_age_seconds",
        "calendar_ref"
      ],
      "properties": {
        "preferred_market_data": {
          "const": "POINT_IN_TIME_BID_ASK_TRADES"
        },
        "daily_bar_fallback": {
          "const": "ADVERSE_TRADE_THROUGH_ONLY"
        },
        "volume_required": {
          "const": true
        },
        "quote_max_age_seconds": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeIntegerString"
        },
        "calendar_ref": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
        }
      }
    },
    "fill_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "same_session_fill_allowed",
        "first_eligible_event",
        "unknown_intrabar_sequence",
        "partial_fills",
        "auction_treatment",
        "halt_treatment",
        "max_volume_participation",
        "max_order_adv_fraction",
        "adv_lookback_sessions",
        "adv_estimator",
        "price_rounding",
        "quantity_rounding"
      ],
      "properties": {
        "same_session_fill_allowed": {
          "const": false
        },
        "first_eligible_event": {
          "const": "STRICTLY_LATER_MARKET_EVENT"
        },
        "unknown_intrabar_sequence": {
          "const": "NO_FILL_ON_TOUCH_ONLY"
        },
        "partial_fills": {
          "const": "ENABLED_CAPPED_BY_ELIGIBLE_VOLUME"
        },
        "auction_treatment": {
          "const": "EXCLUDED_UNLESS_EXPLICIT_AUCTION_PRINT"
        },
        "halt_treatment": {
          "const": "NO_FILL"
        },
        "max_volume_participation": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/unitDecimal6"
        },
        "max_order_adv_fraction": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/unitDecimal6"
        },
        "adv_lookback_sessions": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/positiveIntegerString"
        },
        "adv_estimator": {
          "const": "MEDIAN_COMPLETE_SESSIONS"
        },
        "price_rounding": {
          "const": "ADVERSE_TO_EFFECTIVE_TICK"
        },
        "quantity_rounding": {
          "const": "FLOOR_TO_EFFECTIVE_BOARD_LOT"
        }
      }
    },
    "base_costs": {
      "$ref": "#/$defs/costScenario"
    },
    "stress_costs": {
      "$ref": "#/$defs/costScenario"
    },
    "incomplete_action": {
      "const": "NO_FILL_AND_MARK_INCOMPLETE"
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_mode",
        "simulated_only",
        "non_executable",
        "broker_capability"
      ],
      "properties": {
        "evaluation_mode": {
          "const": "PAPER_ONLY"
        },
        "simulated_only": {
          "const": true
        },
        "non_executable": {
          "const": true
        },
        "broker_capability": {
          "const": "ABSENT"
        }
      }
    }
  },
  "$defs": {
    "costScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario",
        "half_spread_multiplier",
        "slippage_bps",
        "impact_model",
        "impact_coefficient",
        "minimum_cost_bps",
        "fee_schedule_selection"
      ],
      "properties": {
        "scenario": {
          "enum": [
            "BASE",
            "STRESS"
          ]
        },
        "half_spread_multiplier": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "slippage_bps": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "impact_model": {
          "const": "SQRT_PARTICIPATION"
        },
        "impact_coefficient": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "minimum_cost_bps": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
        },
        "fee_schedule_selection": {
          "const": "EFFECTIVE_AT_SIMULATED_FILL"
        }
      }
    }
  }
}
