{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asxos.local/schemas/thesis-proposal-v1.schema.json",
  "title": "ThesisProposalV1",
  "description": "Versioned, evidence-linked input to the governed thesis materializer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "schema_version",
    "producer",
    "subject",
    "created_at",
    "proposal",
    "canonical_hash"
  ],
  "properties": {
    "contract_name": {
      "const": "thesis-proposal-v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "proposal": {
      "$ref": "#/$defs/proposal"
    },
    "canonical_hash": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/canonicalHash"
    }
  },
  "$defs": {
    "decimalString": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,6})?$"
    },
    "evidenceReference": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "pattern": "^local:[0-9]+$"
        }
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_name",
        "agent_version",
        "run_id"
      ],
      "properties": {
        "agent_name": {
          "type": "string",
          "minLength": 1
        },
        "agent_version": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "pattern": "^[A-Z0-9]+\\.(AU|US)$"
        }
      }
    },
    "reportFigure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "value",
        "provenance",
        "evidence_citation_ids"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "$ref": "#/$defs/decimalString"
        },
        "provenance": {
          "enum": [
            "cited",
            "derived",
            "james_input"
          ]
        },
        "evidence_citation_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceReference"
          },
          "uniqueItems": true
        },
        "formula": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "cited"
              }
            },
            "required": [
              "provenance"
            ]
          },
          "then": {
            "properties": {
              "evidence_citation_ids": {
                "minItems": 1
              },
              "formula": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "derived"
              }
            },
            "required": [
              "provenance"
            ]
          },
          "then": {
            "required": [
              "formula"
            ],
            "properties": {
              "evidence_citation_ids": {
                "minItems": 1
              },
              "formula": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "james_input"
              }
            },
            "required": [
              "provenance"
            ]
          },
          "then": {
            "properties": {
              "evidence_citation_ids": {
                "maxItems": 0
              },
              "formula": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "reportSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "body",
        "figures",
        "evidence_citation_ids"
      ],
      "properties": {
        "kind": {
          "enum": [
            "identity_classification",
            "business",
            "moat",
            "capital_allocation",
            "strategy_catalysts",
            "risks_bear",
            "valuation",
            "position_plan",
            "verdict_conviction",
            "evidence_ledger"
          ]
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "figures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reportFigure"
          }
        },
        "evidence_citation_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceReference"
          },
          "uniqueItems": true
        }
      }
    },
    "invalidationCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition",
        "severity"
      ],
      "properties": {
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "material",
            "critical"
          ]
        },
        "evidence_citation_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceReference"
          },
          "uniqueItems": true
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "flavour",
        "thesis_text",
        "themes",
        "invalidation_conditions",
        "sections",
        "evidence_citation_ids"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "pattern": "^[A-Z0-9]+\\.(AU|US)$"
        },
        "flavour": {
          "enum": [
            "individual_equity",
            "etf_fund"
          ]
        },
        "thesis_text": {
          "type": "string",
          "minLength": 1
        },
        "conviction_level": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5,
          "description": "Research annotation only; forbidden as a sizing input."
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "entry_band_lower": {
          "oneOf": [
            {
              "$ref": "#/$defs/reportFigure"
            },
            {
              "type": "null"
            }
          ]
        },
        "entry_band_upper": {
          "oneOf": [
            {
              "$ref": "#/$defs/reportFigure"
            },
            {
              "type": "null"
            }
          ]
        },
        "stop_price": {
          "oneOf": [
            {
              "$ref": "#/$defs/reportFigure"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_price": {
          "oneOf": [
            {
              "$ref": "#/$defs/reportFigure"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeline_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "invalidation_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/invalidationCondition"
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reportSection"
          }
        },
        "evidence_citation_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
