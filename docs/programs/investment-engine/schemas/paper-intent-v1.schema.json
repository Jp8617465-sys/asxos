{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asxos.local/schemas/paper-intent-v1.schema.json",
  "title": "ASXOS Paper Intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "schema_version",
    "producer_version",
    "data_as_of",
    "created_at",
    "source_hashes",
    "intent_id",
    "origin_ref",
    "proposal_ref",
    "sizing_decision_ref",
    "branch_id",
    "knowledge_cutoff",
    "recorded_at",
    "status",
    "lines",
    "reason_codes",
    "canonical_hash",
    "controls"
  ],
  "properties": {
    "contract_name": {
      "const": "paper-intent-v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "producer_version": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/version"
    },
    "data_as_of": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "source_hashes": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/sourceHashes"
    },
    "canonical_hash": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/canonicalHash"
    },
    "intent_id": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
    },
    "origin_ref": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
    },
    "proposal_ref": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
    },
    "sizing_decision_ref": {
      "allOf": [
        {
          "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
        },
        {
          "properties": {
            "contract_name": {
              "const": "sizing-decision-v1"
            }
          }
        }
      ]
    },
    "branch_id": {
      "enum": [
        "PROPOSAL_BASE",
        "PROPOSAL_STRESS"
      ]
    },
    "knowledge_cutoff": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "recorded_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "status": {
      "enum": [
        "RECORDED",
        "NO_ACTION",
        "REJECTED"
      ]
    },
    "lines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/intentLine"
      }
    },
    "reason_codes": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/reasonCodes"
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_mode",
        "is_order",
        "non_executable",
        "live_holdings_write"
      ],
      "properties": {
        "evaluation_mode": {
          "const": "PAPER_ONLY"
        },
        "is_order": {
          "const": false
        },
        "non_executable": {
          "const": true
        },
        "live_holdings_write": {
          "const": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "RECORDED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "lines": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "NO_ACTION",
              "REJECTED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "lines": {
            "maxItems": 0
          },
          "reason_codes": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "intentLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line_id",
        "asset_id",
        "side",
        "requested_quantity",
        "requested_notional_aud",
        "reference_price_aud",
        "sizing_line_id",
        "sizing_line_sha256",
        "source_sha256",
        "reason_codes"
      ],
      "properties": {
        "line_id": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
        },
        "asset_id": {
          "type": "string",
          "pattern": "^XASX:[A-Z0-9]{3,6}$"
        },
        "side": {
          "enum": [
            "BUY",
            "SELL"
          ]
        },
        "requested_quantity": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/positiveIntegerString"
        },
        "requested_notional_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/positiveDecimal6"
        },
        "reference_price_aud": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/positiveDecimal6"
        },
        "sizing_line_id": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
        },
        "sizing_line_sha256": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
        },
        "source_sha256": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
        },
        "reason_codes": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/reasonCodes"
        }
      }
    }
  }
}
