{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asxos.local/schemas/benchmark-policy-v1.schema.json",
  "title": "ASXOS Benchmark Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "schema_version",
    "producer_version",
    "data_as_of",
    "created_at",
    "source_hashes",
    "benchmark_policy_id",
    "benchmark_policy_version",
    "xjo_tr",
    "hold",
    "cash",
    "endpoint_policy",
    "missing_data_action",
    "canonical_hash",
    "controls"
  ],
  "properties": {
    "contract_name": {
      "const": "benchmark-policy-v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "producer_version": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/version"
    },
    "data_as_of": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "source_hashes": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/sourceHashes"
    },
    "canonical_hash": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/canonicalHash"
    },
    "benchmark_policy_id": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
    },
    "benchmark_policy_version": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/version"
    },
    "xjo_tr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_id",
        "data_class",
        "return_class",
        "comparison_label",
        "dividend_reinvestment",
        "publication_lag_required"
      ],
      "properties": {
        "benchmark_id": {
          "const": "XJO-TR"
        },
        "data_class": {
          "const": "GENUINE_POINT_IN_TIME"
        },
        "return_class": {
          "const": "GROSS_TOTAL_RETURN_INDEX"
        },
        "comparison_label": {
          "const": "CONSERVATIVE_HURDLE_NOT_BENCHMARK_NEUTRAL_ALPHA"
        },
        "dividend_reinvestment": {
          "const": "INDEX_METHODOLOGY"
        },
        "publication_lag_required": {
          "const": true
        }
      }
    },
    "hold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discretionary_trades",
        "corporate_actions",
        "income",
        "tax_and_cost",
        "external_flows"
      ],
      "properties": {
        "discretionary_trades": {
          "const": "NONE"
        },
        "corporate_actions": {
          "const": "APPLY_POINT_IN_TIME"
        },
        "income": {
          "const": "APPLY_POINT_IN_TIME"
        },
        "tax_and_cost": {
          "const": "ACCOUNTING_POLICY"
        },
        "external_flows": {
          "const": "MIRROR_PROPOSAL_BRANCH"
        }
      }
    },
    "cash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rate_source",
        "rate_data_class",
        "compounding",
        "tax_treatment",
        "external_flows"
      ],
      "properties": {
        "rate_source": {
          "const": "OBSERVABLE_ACCOUNT_OR_CASH_RATE"
        },
        "rate_data_class": {
          "const": "POINT_IN_TIME"
        },
        "compounding": {
          "const": "DAILY_ACT_365"
        },
        "tax_treatment": {
          "const": "ACCOUNTING_POLICY"
        },
        "external_flows": {
          "const": "MIRROR_PROPOSAL_BRANCH"
        }
      }
    },
    "endpoint_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "same_origin",
        "same_maturity",
        "same_calendar",
        "same_flow_timing"
      ],
      "properties": {
        "same_origin": {
          "const": true
        },
        "same_maturity": {
          "const": true
        },
        "same_calendar": {
          "const": true
        },
        "same_flow_timing": {
          "const": true
        }
      }
    },
    "missing_data_action": {
      "const": "COMPARISON_UNAVAILABLE_NO_SUBSTITUTE"
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "price_only_substitution",
        "remembered_rate_substitution",
        "non_executable"
      ],
      "properties": {
        "price_only_substitution": {
          "const": false
        },
        "remembered_rate_substitution": {
          "const": false
        },
        "non_executable": {
          "const": true
        }
      }
    }
  }
}
