{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asxos.local/schemas/portfolio-construction-policy-v1.schema.json",
  "title": "Portfolio Construction Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "schema_version",
    "policy_id",
    "policy_version",
    "effective_from",
    "effective_to",
    "approval",
    "scope",
    "eligibility",
    "risk_budget_at_stop",
    "classification_freshness",
    "cap_waterfall",
    "selection",
    "tax_turnover",
    "fallbacks",
    "controls",
    "source_hashes",
    "created_at",
    "canonical_hash"
  ],
  "properties": {
    "contract_name": {
      "const": "portfolio-construction-policy-v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "policy_id": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
    },
    "policy_version": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/version"
    },
    "effective_from": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
    },
    "effective_to": {
      "oneOf": [
        {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "approval": {
      "$ref": "#/$defs/approval"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "eligibility": {
      "$ref": "#/$defs/eligibility"
    },
    "risk_budget_at_stop": {
      "$ref": "#/$defs/riskBudgetAtStop"
    },
    "cap_waterfall": {
      "$ref": "#/$defs/capWaterfall"
    },
    "selection": {
      "$ref": "#/$defs/selection"
    },
    "tax_turnover": {
      "$ref": "#/$defs/taxTurnover"
    },
    "fallbacks": {
      "$ref": "#/$defs/fallbacks"
    },
    "controls": {
      "$ref": "#/$defs/controls"
    },
    "source_hashes": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/sourceHashes"
    },
    "created_at": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
    },
    "canonical_hash": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/canonicalHash"
    },
    "classification_freshness": {
      "$ref": "#/$defs/classificationFreshness"
    }
  },
  "$defs": {
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ratified_by",
        "authority_role",
        "ratified_at",
        "approval_sha256"
      ],
      "properties": {
        "ratified_by": {
          "const": "James"
        },
        "authority_role": {
          "const": "ACCOUNT_OWNER"
        },
        "ratified_at": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
        },
        "approval_sha256": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portfolio_id",
        "environment",
        "venue",
        "currency",
        "asset_class",
        "long_only"
      ],
      "properties": {
        "portfolio_id": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
        },
        "environment": {
          "const": "PAPER_ONLY"
        },
        "venue": {
          "const": "XASX"
        },
        "currency": {
          "const": "AUD"
        },
        "asset_class": {
          "const": "EQUITY"
        },
        "long_only": {
          "const": true
        }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_review_decision",
        "required_case_state",
        "allowed_evidence_tiers",
        "require_current_report",
        "require_clear_monitor_watermark",
        "require_frozen_evaluator_lineage",
        "require_complete_security_classification"
      ],
      "properties": {
        "required_review_decision": {
          "const": "PAPER_ELIGIBLE"
        },
        "required_case_state": {
          "const": "SHADOW_ACTIVE"
        },
        "allowed_evidence_tiers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "PAPER_ONLY",
              "UNCALIBRATED",
              "EVIDENCE_BACKED"
            ]
          }
        },
        "require_current_report": {
          "const": true
        },
        "require_clear_monitor_watermark": {
          "const": true
        },
        "require_frozen_evaluator_lineage": {
          "const": true
        },
        "require_complete_security_classification": {
          "const": true
        }
      }
    },
    "riskBudgetAtStop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "portfolio_risk_budget_fraction",
        "per_case_risk_budget_fraction",
        "stop_distance_floor_fraction",
        "formula_version"
      ],
      "properties": {
        "method": {
          "const": "EQUAL_RISK_BUDGET_AT_STOP"
        },
        "portfolio_risk_budget_fraction": {
          "$ref": "#/$defs/positiveUnitDecimal"
        },
        "per_case_risk_budget_fraction": {
          "$ref": "#/$defs/positiveUnitDecimal"
        },
        "stop_distance_floor_fraction": {
          "$ref": "#/$defs/positiveUnitDecimal"
        },
        "formula_version": {
          "const": "RISK_BUDGET_DIVIDED_BY_MAX_STOP_DISTANCE_V1"
        }
      }
    },
    "capWaterfall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordered_caps",
        "later_cap_may_increase_weight",
        "final_selection"
      ],
      "properties": {
        "ordered_caps": {
          "const": [
            "ELIGIBILITY",
            "CLASSIFICATION",
            "STOP_RISK",
            "ISSUER",
            "CORPORATE_GROUP",
            "SINGLE_NAME",
            "SECTOR",
            "THEME",
            "PORTFOLIO_LOSS_AT_STOP",
            "GROSS_EXPOSURE",
            "NET_EXPOSURE",
            "CASH_RESERVE",
            "TURNOVER",
            "RESERVATIONS",
            "LIQUIDITY_ADV_SPREAD",
            "TAX",
            "MINIMUM_TARGET"
          ]
        },
        "later_cap_may_increase_weight": {
          "const": false
        },
        "final_selection": {
          "const": "MINIMUM_PERMITTED_WEIGHT"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_method",
        "maximum_positions",
        "tie_break",
        "ranking_score_permitted",
        "conviction_weighting_permitted"
      ],
      "properties": {
        "candidate_method": {
          "const": "ALL_ELIGIBLE"
        },
        "maximum_positions": {
          "type": "integer",
          "minimum": 1
        },
        "tie_break": {
          "const": "ASSET_ID_ASCENDING"
        },
        "ranking_score_permitted": {
          "const": false
        },
        "conviction_weighting_permitted": {
          "const": false
        }
      }
    },
    "taxTurnover": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cash_first",
        "sale_lot_selection_source",
        "tax_engine_result_required",
        "missing_tax_result"
      ],
      "properties": {
        "cash_first": {
          "const": true
        },
        "sale_lot_selection_source": {
          "const": "DETERMINISTIC_TAX_ENGINE"
        },
        "tax_engine_result_required": {
          "const": true
        },
        "missing_tax_result": {
          "const": "REJECT_INCOMPLETE_INPUT"
        }
      }
    },
    "fallbacks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_stop",
        "invalid_stop",
        "missing_policy",
        "missing_required_input",
        "missing_or_ambiguous_classification",
        "infeasible_portfolio",
        "empty_eligible_universe"
      ],
      "properties": {
        "missing_stop": {
          "const": "REJECT_NO_STOP"
        },
        "invalid_stop": {
          "const": "REJECT_INVALID_STOP"
        },
        "missing_policy": {
          "const": "REJECT_NO_POLICY"
        },
        "missing_required_input": {
          "const": "REJECT_INCOMPLETE_INPUT"
        },
        "missing_or_ambiguous_classification": {
          "const": "REJECT_INCOMPLETE_INPUT"
        },
        "infeasible_portfolio": {
          "const": "HOLD_CASH"
        },
        "empty_eligible_universe": {
          "const": "HOLD_CASH"
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic_decimal_math",
        "llm_numeric_output_permitted",
        "implicit_defaults_permitted",
        "legacy_allocator_permitted",
        "non_executable"
      ],
      "properties": {
        "deterministic_decimal_math": {
          "const": true
        },
        "llm_numeric_output_permitted": {
          "const": false
        },
        "implicit_defaults_permitted": {
          "const": false
        },
        "legacy_allocator_permitted": {
          "const": false
        },
        "non_executable": {
          "const": true
        }
      }
    },
    "positiveUnitDecimal": {
      "type": "string",
      "pattern": "^(?:0\\.(?!000000$)[0-9]{6}|1\\.000000)$"
    },
    "classificationFreshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_age_seconds",
        "require_effective_at_decision",
        "require_snapshot_available_by_cutoff"
      ],
      "properties": {
        "maximum_age_seconds": {
          "const": 600
        },
        "require_effective_at_decision": {
          "const": true
        },
        "require_snapshot_available_by_cutoff": {
          "const": true
        }
      }
    }
  }
}
