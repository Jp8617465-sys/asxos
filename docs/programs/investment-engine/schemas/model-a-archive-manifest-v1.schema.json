{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asxos.local/schemas/model-a-archive-manifest-v1.schema.json",
  "title": "ASXOS Model A Archive Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "schema_version",
    "producer_version",
    "data_as_of",
    "created_at",
    "source_hashes",
    "archive_id",
    "archive_version",
    "created_by",
    "baseline_sha",
    "deployment_environment",
    "source_snapshot_id",
    "source_snapshot_started_at",
    "source_snapshot_completed_at",
    "writer_state_at_snapshot",
    "evidence_scope",
    "manifest_status",
    "expected_classes",
    "archive_classes",
    "secret_scan",
    "retention",
    "reason_codes",
    "notes",
    "controls",
    "canonical_hash"
  ],
  "properties": {
    "contract_name": {
      "const": "model-a-archive-manifest-v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "producer_version": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/version"
    },
    "data_as_of": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "source_hashes": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/sourceHashes"
    },
    "archive_id": {
      "type": "string",
      "pattern": "^ma-archive-[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]{8}t[0-9]{6}z$"
    },
    "archive_version": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/version"
    },
    "created_by": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
    },
    "baseline_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{7,64}$"
    },
    "deployment_environment": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "source_snapshot_id": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
    },
    "source_snapshot_started_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "source_snapshot_completed_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "writer_state_at_snapshot": {
      "enum": [
        "ACTIVE",
        "DISABLED",
        "UNKNOWN"
      ]
    },
    "writer_disabled_at": {
      "oneOf": [
        {
          "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_scope": {
      "enum": [
        "SYNTHETIC_GOLDEN",
        "ATTENDED_SOURCE_OBSERVATION"
      ]
    },
    "manifest_status": {
      "enum": [
        "SEALED",
        "NOT_READY"
      ]
    },
    "expected_classes": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/archiveClassName"
      }
    },
    "archive_classes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/archiveClass"
      }
    },
    "secret_scan": {
      "$ref": "#/$defs/secretScan"
    },
    "retention": {
      "$ref": "#/$defs/retention"
    },
    "reason_codes": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/reasonCodes"
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    },
    "controls": {
      "$ref": "#/$defs/controls"
    },
    "canonical_hash": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/canonicalHash"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "writer_disabled_at": {
            "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
          }
        },
        "required": [
          "writer_disabled_at"
        ]
      },
      "then": {
        "properties": {
          "writer_state_at_snapshot": {
            "const": "DISABLED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "manifest_status": {
            "const": "SEALED"
          }
        },
        "required": [
          "manifest_status"
        ]
      },
      "then": {
        "properties": {
          "archive_classes": {
            "minItems": 8,
            "maxItems": 8,
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/archiveClass"
                },
                {
                  "properties": {
                    "class_status": {
                      "const": "COMPLETE"
                    },
                    "reason_codes": {
                      "maxItems": 0
                    }
                  }
                }
              ]
            }
          },
          "secret_scan": {
            "properties": {
              "status": {
                "const": "PASS"
              },
              "finding_count": {
                "const": "0"
              }
            }
          },
          "retention": {
            "properties": {
              "archive_immutable": {
                "const": true
              },
              "application_writer_access": {
                "const": "DENIED"
              }
            }
          },
          "reason_codes": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "manifest_status": {
            "const": "NOT_READY"
          }
        },
        "required": [
          "manifest_status"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_scope": {
            "const": "SYNTHETIC_GOLDEN"
          }
        },
        "required": [
          "evidence_scope"
        ]
      },
      "then": {
        "properties": {
          "deployment_environment": {
            "const": "synthetic-test"
          },
          "controls": {
            "properties": {
              "production_evidence_claimed": {
                "const": false
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "archiveClassName": {
      "enum": [
        "ALLOCATOR_DERIVED_RECORDS",
        "CODE_AND_MIGRATION_FILES",
        "DECAY_ANALYSIS_BUNDLE",
        "JOB_RUN_AND_SCHEDULE_EVIDENCE",
        "MODEL_ARTIFACT_FILES",
        "MODEL_CONFIG_ROWS",
        "SIGNAL_OUTCOME_ROWS",
        "SIGNAL_ROWS"
      ]
    },
    "observedRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "range_field",
        "minimum_observed_at",
        "maximum_observed_at"
      ],
      "properties": {
        "range_field": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "minimum_observed_at": {
          "oneOf": [
            {
              "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "maximum_observed_at": {
          "oneOf": [
            {
              "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "range_field": {
                "type": "null"
              }
            },
            "required": [
              "range_field"
            ]
          },
          "then": {
            "properties": {
              "minimum_observed_at": {
                "type": "null"
              },
              "maximum_observed_at": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "range_field": {
                "type": "string"
              }
            },
            "required": [
              "range_field"
            ]
          },
          "then": {
            "properties": {
              "minimum_observed_at": {
                "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
              },
              "maximum_observed_at": {
                "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
              }
            }
          }
        }
      ]
    },
    "archiveClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_class_id",
        "dataset_or_artifact_class",
        "model_identities",
        "logical_locator",
        "representation",
        "media_type",
        "columns",
        "order_by",
        "record_count",
        "file_count",
        "raw_byte_count",
        "observed_range",
        "export_definition_sha256",
        "raw_sha256",
        "canonical_sha256",
        "raw_digest_method",
        "canonical_digest_method",
        "class_status",
        "reason_codes"
      ],
      "properties": {
        "archive_class_id": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
        },
        "dataset_or_artifact_class": {
          "$ref": "#/$defs/archiveClassName"
        },
        "model_identities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "model_a",
              "model_a_ml",
              "v1_5"
            ]
          }
        },
        "logical_locator": {
          "type": "string",
          "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*://)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]{2,255}$"
        },
        "representation": {
          "enum": [
            "CANONICAL_NDJSON",
            "DETERMINISTIC_FILE_BUNDLE"
          ]
        },
        "media_type": {
          "enum": [
            "application/x-ndjson",
            "application/vnd.asxos.deterministic-file-bundle"
          ]
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          }
        },
        "order_by": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,63} (?:ASC|DESC)(?: NULLS (?:FIRST|LAST))?$"
          }
        },
        "record_count": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeIntegerString"
        },
        "file_count": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeIntegerString"
        },
        "raw_byte_count": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeIntegerString"
        },
        "observed_range": {
          "$ref": "#/$defs/observedRange"
        },
        "export_definition_sha256": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
        },
        "raw_sha256": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
        },
        "canonical_sha256": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
        },
        "raw_digest_method": {
          "enum": [
            "SHA256_CANONICAL_NDJSON_LF",
            "SHA256_DETERMINISTIC_FILE_BUNDLE"
          ]
        },
        "canonical_digest_method": {
          "const": "SHA256_RFC8785_METADATA_NDJSON_LF"
        },
        "class_status": {
          "enum": [
            "COMPLETE",
            "INCOMPLETE"
          ]
        },
        "reason_codes": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/reasonCodes"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "representation": {
                "const": "CANONICAL_NDJSON"
              }
            },
            "required": [
              "representation"
            ]
          },
          "then": {
            "properties": {
              "media_type": {
                "const": "application/x-ndjson"
              },
              "raw_digest_method": {
                "const": "SHA256_CANONICAL_NDJSON_LF"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "representation": {
                "const": "DETERMINISTIC_FILE_BUNDLE"
              }
            },
            "required": [
              "representation"
            ]
          },
          "then": {
            "properties": {
              "media_type": {
                "const": "application/vnd.asxos.deterministic-file-bundle"
              },
              "raw_digest_method": {
                "const": "SHA256_DETERMINISTIC_FILE_BUNDLE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "class_status": {
                "const": "COMPLETE"
              }
            },
            "required": [
              "class_status"
            ]
          },
          "then": {
            "properties": {
              "reason_codes": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "class_status": {
                "const": "INCOMPLETE"
              }
            },
            "required": [
              "class_status"
            ]
          },
          "then": {
            "properties": {
              "reason_codes": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "secretScan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "finding_count",
        "scanner_version",
        "completed_at",
        "report_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ]
        },
        "finding_count": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeIntegerString"
        },
        "scanner_version": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/version"
        },
        "completed_at": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
        },
        "report_sha256": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retention_class",
        "access_policy_id",
        "access_policy_sha256",
        "archive_immutable",
        "application_writer_access",
        "deletion_requires_separate_governance_decision"
      ],
      "properties": {
        "retention_class": {
          "const": "READ_ONLY_AUDIT"
        },
        "access_policy_id": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
        },
        "access_policy_sha256": {
          "$ref": "evaluator-common-v1.schema.json#/$defs/sha256"
        },
        "archive_immutable": {
          "const": true
        },
        "application_writer_access": {
          "const": "DENIED"
        },
        "deletion_requires_separate_governance_decision": {
          "const": true
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_mode",
        "source_snapshot_read_only",
        "source_mutation_performed",
        "production_configuration_change",
        "runtime_shutdown_claimed",
        "runtime_change_authority",
        "production_evidence_claimed",
        "runtime_retirement_approval_claimed",
        "destructive_action",
        "non_executable"
      ],
      "properties": {
        "mission_mode": {
          "const": "READ_ONLY_ARCHIVE"
        },
        "source_snapshot_read_only": {
          "const": true
        },
        "source_mutation_performed": {
          "const": false
        },
        "production_configuration_change": {
          "const": false
        },
        "runtime_shutdown_claimed": {
          "const": false
        },
        "runtime_change_authority": {
          "const": "ABSENT"
        },
        "production_evidence_claimed": {
          "type": "boolean"
        },
        "runtime_retirement_approval_claimed": {
          "const": false
        },
        "destructive_action": {
          "const": false
        },
        "non_executable": {
          "const": true
        }
      }
    }
  }
}
