{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asxos.local/schemas/paper-fill-v1.schema.json",
  "title": "ASXOS Paper Fill v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "schema_version",
    "producer_version",
    "data_as_of",
    "created_at",
    "source_hashes",
    "paper_fill_id",
    "paper_order_ref",
    "fill_model_ref",
    "market_event",
    "branch_id",
    "asset_id",
    "side",
    "cost_scenario",
    "filled_at",
    "filled_quantity",
    "cumulative_filled_quantity",
    "eligible_volume",
    "participation_fraction",
    "reference_price_aud",
    "fill_price_aud",
    "spread_cost_aud",
    "slippage_cost_aud",
    "impact_cost_aud",
    "fee_aud",
    "gross_consideration_aud",
    "total_cash_effect_aud",
    "limit_rule_passed",
    "canonical_hash",
    "controls"
  ],
  "properties": {
    "contract_name": {
      "const": "paper-fill-v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "producer_version": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/version"
    },
    "data_as_of": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "source_hashes": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/sourceHashes"
    },
    "canonical_hash": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/canonicalHash"
    },
    "paper_fill_id": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/identifier"
    },
    "paper_order_ref": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
    },
    "fill_model_ref": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/artifactRef"
    },
    "market_event": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/sourceRef"
    },
    "branch_id": {
      "enum": [
        "PROPOSAL_BASE",
        "PROPOSAL_STRESS"
      ]
    },
    "asset_id": {
      "type": "string",
      "pattern": "^XASX:[A-Z0-9]{3,6}$"
    },
    "side": {
      "enum": [
        "BUY",
        "SELL"
      ]
    },
    "cost_scenario": {
      "enum": [
        "BASE",
        "STRESS"
      ]
    },
    "filled_at": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/timestamp"
    },
    "filled_quantity": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/positiveIntegerString"
    },
    "cumulative_filled_quantity": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/positiveIntegerString"
    },
    "eligible_volume": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/positiveIntegerString"
    },
    "participation_fraction": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/unitDecimal6"
    },
    "reference_price_aud": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/positiveDecimal6"
    },
    "fill_price_aud": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/positiveDecimal6"
    },
    "spread_cost_aud": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
    },
    "slippage_cost_aud": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
    },
    "impact_cost_aud": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
    },
    "fee_aud": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/nonNegativeDecimal6"
    },
    "gross_consideration_aud": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/positiveDecimal6"
    },
    "total_cash_effect_aud": {
      "$ref": "evaluator-common-v1.schema.json#/$defs/decimal6"
    },
    "limit_rule_passed": {
      "const": true
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_mode",
        "simulated",
        "non_executable",
        "actual_later_market_event",
        "live_holdings_write"
      ],
      "properties": {
        "evaluation_mode": {
          "const": "PAPER_ONLY"
        },
        "simulated": {
          "const": true
        },
        "non_executable": {
          "const": true
        },
        "actual_later_market_event": {
          "const": true
        },
        "live_holdings_write": {
          "const": false
        }
      }
    }
  }
}
