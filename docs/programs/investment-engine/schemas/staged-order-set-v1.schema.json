{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asxos.local/schemas/staged-order-set-v1.schema.json",
  "title": "ASXOS Staged Order Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "schema_version",
    "producer",
    "order_set_id",
    "investment_case_id",
    "portfolio_id",
    "lineage",
    "evidence_tier",
    "staging_policy_ref",
    "sizing_decision_ref",
    "promotion_evidence",
    "gate_evidence",
    "data_as_of",
    "knowledge_cutoff",
    "created_at",
    "expires_at",
    "source_hashes",
    "orders",
    "estimated_total_notional_aud",
    "estimated_total_fees_aud",
    "user_approval",
    "controls",
    "canonical_hash"
  ],
  "properties": {
    "contract_name": {
      "const": "staged-order-set-v1"
    },
    "schema_version": {
      "const": "1.1.0"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "order_set_id": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
    },
    "investment_case_id": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
    },
    "portfolio_id": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
    },
    "lineage": {
      "allOf": [
        {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/caseLineage"
        },
        {
          "properties": {
            "lineage_stage": {
              "const": "SIZE_DECIDED"
            },
            "case_state": {
              "const": "ADVICE_READY"
            },
            "staging_policy_ref": {
              "type": "null"
            },
            "promotion_decision_ref": {
              "type": "null"
            },
            "staged_order_set_ref": {
              "type": "null"
            }
          }
        }
      ]
    },
    "evidence_tier": {
      "enum": [
        "PAPER_ONLY",
        "UNCALIBRATED",
        "EVIDENCE_BACKED"
      ]
    },
    "staging_policy_ref": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/versionedRef"
    },
    "sizing_decision_ref": {
      "$ref": "#/$defs/sizingDecisionRef"
    },
    "promotion_evidence": {
      "$ref": "#/$defs/promotionEvidence"
    },
    "gate_evidence": {
      "$ref": "#/$defs/gateEvidence"
    },
    "data_as_of": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
    },
    "knowledge_cutoff": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
    },
    "source_hashes": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/sourceHashes"
    },
    "orders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stagedOrder"
      }
    },
    "estimated_total_notional_aud": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/positiveDecimal"
    },
    "estimated_total_fees_aud": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/nonNegativeDecimal"
    },
    "user_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approved_at"
      ],
      "properties": {
        "status": {
          "const": "REQUIRED_NOT_GRANTED"
        },
        "approved_at": {
          "type": "null"
        }
      }
    },
    "controls": {
      "$ref": "#/$defs/controls"
    },
    "canonical_hash": {
      "$ref": "investment-case-lineage-v1.schema.json#/$defs/canonicalHash"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_tier": {
            "const": "PAPER_ONLY"
          }
        },
        "required": [
          "evidence_tier"
        ]
      },
      "then": {
        "properties": {
          "gate_evidence": {
            "properties": {
              "strategy_gate_passed": {
                "const": false
              }
            }
          },
          "promotion_evidence": {
            "properties": {
              "decision": {
                "const": "HOLD_PAPER_ONLY"
              },
              "permitted_evidence_tier": {
                "const": "PAPER_ONLY"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_tier": {
            "const": "UNCALIBRATED"
          }
        },
        "required": [
          "evidence_tier"
        ]
      },
      "then": {
        "properties": {
          "gate_evidence": {
            "properties": {
              "strategy_gate_passed": {
                "const": false
              }
            }
          },
          "promotion_evidence": {
            "properties": {
              "decision": {
                "const": "APPROVE_UNCALIBRATED_VISIBILITY"
              },
              "permitted_evidence_tier": {
                "const": "UNCALIBRATED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_tier": {
            "const": "EVIDENCE_BACKED"
          }
        },
        "required": [
          "evidence_tier"
        ]
      },
      "then": {
        "properties": {
          "gate_evidence": {
            "properties": {
              "strategy_gate_passed": {
                "const": true
              }
            }
          },
          "promotion_evidence": {
            "properties": {
              "decision": {
                "const": "APPROVE_EVIDENCE_BACKED_LANGUAGE"
              },
              "permitted_evidence_tier": {
                "const": "EVIDENCE_BACKED"
              },
              "decided_by": {
                "const": "James"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_type",
        "method",
        "producer_version",
        "code_version"
      ],
      "properties": {
        "producer_type": {
          "const": "DETERMINISTIC_QUANT"
        },
        "method": {
          "const": "STAGING_POLICY_TRANSFORM"
        },
        "producer_version": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/version"
        },
        "code_version": {
          "type": "string",
          "pattern": "^[a-f0-9]{7,64}$"
        }
      }
    },
    "sizingDecisionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "status",
        "eligible_for_staging",
        "proposal_sha256",
        "construction_policy_sha256",
        "risk_policy_sha256"
      ],
      "properties": {
        "id": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
        },
        "sha256": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/sha256"
        },
        "status": {
          "const": "SIZED"
        },
        "eligible_for_staging": {
          "const": true
        },
        "proposal_sha256": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/sha256"
        },
        "construction_policy_sha256": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/sha256"
        },
        "risk_policy_sha256": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "promotionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotion_decision_ref",
        "decision",
        "permitted_evidence_tier",
        "decided_by",
        "effective_at"
      ],
      "properties": {
        "promotion_decision_ref": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/hashRef"
        },
        "decision": {
          "enum": [
            "HOLD_PAPER_ONLY",
            "APPROVE_UNCALIBRATED_VISIBILITY",
            "APPROVE_EVIDENCE_BACKED_LANGUAGE"
          ]
        },
        "permitted_evidence_tier": {
          "enum": [
            "PAPER_ONLY",
            "UNCALIBRATED",
            "EVIDENCE_BACKED"
          ]
        },
        "decided_by": {
          "const": "James"
        },
        "effective_at": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
        }
      }
    },
    "gateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_policy_ref",
        "evaluation_ref",
        "gate_decision_ref",
        "evaluation_complete",
        "operational_gate_passed",
        "strategy_gate_passed"
      ],
      "properties": {
        "evaluation_policy_ref": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/versionedRef"
        },
        "evaluation_ref": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/hashRef"
        },
        "gate_decision_ref": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/hashRef"
        },
        "evaluation_complete": {
          "const": true
        },
        "operational_gate_passed": {
          "const": true
        },
        "strategy_gate_passed": {
          "type": "boolean"
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_number",
        "policy_fraction",
        "quantity",
        "not_before",
        "expires_at"
      ],
      "properties": {
        "stage_number": {
          "type": "integer",
          "minimum": 1
        },
        "policy_fraction": {
          "$ref": "#/$defs/positiveUnitDecimal"
        },
        "quantity": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/positiveIntegerString"
        },
        "not_before": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
        }
      }
    },
    "stagedOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "staged_order_id",
        "asset_id",
        "side",
        "total_quantity",
        "reference_price_aud",
        "reference_price_as_of",
        "price_observation_ref",
        "pricing_rule",
        "max_adverse_fraction",
        "raw_limit_price_aud",
        "tick_size_aud",
        "tick_rounding",
        "limit_price_aud",
        "estimated_notional_aud",
        "estimated_fees_aud",
        "stages",
        "invalidation_events"
      ],
      "properties": {
        "staged_order_id": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/identifier"
        },
        "asset_id": {
          "type": "string",
          "pattern": "^XASX:[A-Z0-9]{3,6}$"
        },
        "side": {
          "enum": [
            "BUY",
            "SELL"
          ]
        },
        "total_quantity": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/positiveIntegerString"
        },
        "reference_price_aud": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/positiveDecimal"
        },
        "reference_price_as_of": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/timestamp"
        },
        "price_observation_ref": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/hashRef"
        },
        "pricing_rule": {
          "const": "REFERENCE_PRICE_MAX_ADVERSE_FRACTION"
        },
        "max_adverse_fraction": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/unitDecimal"
        },
        "raw_limit_price_aud": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/positiveDecimal"
        },
        "tick_size_aud": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/positiveDecimal"
        },
        "tick_rounding": {
          "enum": [
            "BUY_FLOOR",
            "SELL_CEILING"
          ]
        },
        "limit_price_aud": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/positiveDecimal"
        },
        "estimated_notional_aud": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/positiveDecimal"
        },
        "estimated_fees_aud": {
          "$ref": "investment-case-lineage-v1.schema.json#/$defs/nonNegativeDecimal"
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stage"
          }
        },
        "invalidation_events": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "POLICY_WITHDRAWN",
              "PROMOTION_WITHDRAWN",
              "GATE_REGRESSION",
              "PRICE_STALE",
              "THESIS_INVALIDATED",
              "CORPORATE_ACTION",
              "LIQUIDITY_BREACH",
              "EXPIRY_REACHED"
            ]
          }
        }
      }
    },
    "positiveUnitDecimal": {
      "type": "string",
      "pattern": "^(?:0\\.(?!000000$)[0-9]{6}|1\\.000000)$"
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_mode",
        "non_executable",
        "automatic_approval_permitted",
        "external_connectivity_permitted",
        "generative_order_fields_permitted",
        "absolute_dependency_firewall",
        "lookahead_permitted"
      ],
      "properties": {
        "execution_mode": {
          "const": "PAPER_ONLY"
        },
        "non_executable": {
          "const": true
        },
        "automatic_approval_permitted": {
          "const": false
        },
        "external_connectivity_permitted": {
          "const": false
        },
        "generative_order_fields_permitted": {
          "const": false
        },
        "absolute_dependency_firewall": {
          "const": true
        },
        "lookahead_permitted": {
          "const": false
        }
      }
    }
  }
}
