    },
    {
      "workflow": "nightly-check",
      "metric": "terminal_failure_count",
      "threshold": "nonzero",
      "window": "1d",
      "evidence_query": "github.actions.runs(workflow=nightly-check,branch=main,conclusion in [failure,cancelled,timed_out],since=24h).count"
    },
    {
      "workflow": "migration-drift",
      "metric": "terminal_failure_count",
      "threshold": "nonzero",
      "window": "1d",
      "evidence_query": "github.actions.runs(workflow=migration-drift,branch=main,conclusion in [failure,cancelled,timed_out],since=24h).count"
