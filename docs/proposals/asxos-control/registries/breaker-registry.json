{
  "workflows": [
    {
      "workflow": "full-check",
      "metric": "main_red_minutes",
      "threshold": ">=30",
      "window": "30m",
      "evidence_query": "github.actions.runs(workflow=full-check,branch=main,conclusion=failure).duration_red_minutes"
    },
    {
      "workflow": "daily-brief",
      "metric": "terminal_failure_count",
      "threshold": "nonzero",
      "window": "1d",
      "evidence_query": "github.actions.runs(workflow=daily-brief,branch=main,conclusion in [failure,cancelled,timed_out],since=24h).count"
    },
    {
      "workflow": "us-positions",
      "metric": "terminal_failure_count",
      "threshold": "nonzero",
      "window": "1d",
      "evidence_query": "github.actions.runs(workflow=us-positions,branch=main,conclusion in [failure,cancelled,timed_out],since=24h).count"
    },
    {
      "workflow": "weekly-research",
      "metric": "terminal_failure_count",
      "threshold": "nonzero",
      "window": "7d",
      "evidence_query": "github.actions.runs(workflow=weekly-research,branch=main,conclusion in [failure,cancelled,timed_out],since=7d).count"
    },
    {
