{
  "permissions": {
    "allow": [
      "mcp__supabase-ro__execute_sql",
      "mcp__github__get_me",
      "mcp__github__list_pull_requests",
      "mcp__github__pull_request_read",
      "mcp__github__list_commits",
      "mcp__github__list_branches",
      "mcp__github__get_job_logs",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__merge_pull_request",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git rev-list:*)",
      "Bash(git merge-base:*)",
      "Bash(git fetch:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git remote -v)",
      "Bash(git add:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -m py_compile:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(python3 -m ruff:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(make check:*)",
      "Bash(gh workflow run full-check.yml:*)",
      "Bash(gh workflow run targeted-ml-tests.yml:*)",
      "Bash(gh workflow run migration-integration.yml:*)",
      "Bash(gh workflow run backup.yml:*)",
      "Bash(gh workflow run claude-execute.yml:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue edit:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(echo:*)",
      "Bash(date:*)",
      "Bash(which:*)",
      "Bash(mkdir:*)",
      "Bash(sed -n:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(cut:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(realpath:*)",
      "Bash(git rev-parse:*)"
    ],
    "deny": [
      "mcp__github__enable_pr_auto_merge",
      "Edit(/AGENTS.md)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/agents/**)",
      "Edit(/.claude/commands/**)",
      "Edit(/.claude/rules/**)",
      "Edit(/.claude/skills/**)",
      "Edit(/.github/**)",
      "Edit(/render.yaml)",
      "Edit(/docs/README.md)",
      "Edit(/docs/product/autonomy-policy.md)",
      "Edit(/docs/product/north-star.md)",
      "Edit(/docs/product/arbi-constitution.md)",
      "Edit(/docs/product/arbi-authority.md)",
      "Edit(/docs/product/arbi-permission-model.md)",
      "Edit(/docs/product/arbi-harness.md)",
      "Edit(/docs/product/arbi-scorecard.md)",
      "Edit(/docs/product/arbi-promotion-gate.md)",
      "Edit(/docs/product/arbi-memory-policy.md)",
      "Edit(/docs/product/arbi-dream-policy.md)",
      "Edit(/docs/product/arbi-managed-agent-spec.md)",
      "Edit(/docs/product/arbi-autonomy-loop.md)",
      "Edit(/docs/product/arbi-goal-recipes.md)",
      "Edit(/docs/product/arbi-evals.md)",
      "Edit(/docs/product/guilfoyle-mission-control.md)",
      "Edit(/docs/product/portfolio-manager-charter.md)",
      "Edit(/docs/product/portfolio-policy.md)",
      "Edit(/docs/product/recommendation-schema.md)",
      "Edit(/docs/product/data-contracts.md)",
      "Edit(/docs/product/rubrics/**)",
      "Edit(/docs/product/memory/approved-lessons.md)",
      "Edit(/docs/product/memory/authority-lessons.md)",
      "Edit(/docs/product/memory/project-facts.md)",
      "Edit(/docs/product/memory/promotion-log.md)",
      "Edit(/docs/product/memory/rejected-candidates.md)",
      "Read(.env)",
      "Edit(.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/push-guard.sh"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/authority-guard.sh"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/pr-draft-guard.sh"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/unattended-guard.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/pr-draft-guard.sh"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/unattended-guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/authority-guard.sh"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/unattended-guard.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/authority-guard.sh"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/unattended-guard.sh"
          }
        ]
      },
      {
        "matcher": "MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/authority-guard.sh"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/unattended-guard.sh"
          }
        ]
      },
      {
        "matcher": "NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/authority-guard.sh"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/unattended-guard.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '[\"ASK\", (now|gmtime|strftime(\"%Y-%m-%dT%H:%M:%SZ\")), (.tool_name // \"?\"), (.tool_input.command // .tool_input.file_path // .tool_input.query // .tool_input.url // \"\")] | @tsv' >> \"$CLAUDE_PROJECT_DIR/.claude/permission-requests.log\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '[\"DENY\", (now|gmtime|strftime(\"%Y-%m-%dT%H:%M:%SZ\")), (.tool_name // \"?\"), (.tool_input.command // .tool_input.file_path // .tool_input.query // .tool_input.url // \"\")] | @tsv' >> \"$CLAUDE_PROJECT_DIR/.claude/permission-requests.log\" 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
