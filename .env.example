# asxos environment variable template
# Copy this to .env (gitignored) for local dev, or upload via Render MCP for production.
# Never commit real values. Real production values live in ~/Projects/asxos-secrets/.env.production.

# === Required for API + jobs ===
DATABASE_URL=postgresql://user:pass@host:5432/postgres
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=
EODHD_API_KEY=
RESEND_API_KEY=
BRIEF_FROM_EMAIL=onboarding@resend.dev
BRIEF_TO_EMAIL=jamespcino@gmail.com

# === Optional with defaults ===
FRED_API_KEY=
ASXOS_TZ=Australia/Sydney
ASXOS_API_HOST=127.0.0.1
ASXOS_API_PORT=8788
ASXOS_API_TOKEN=
ASXOS_MODELS_DIR=./models
ASXOS_DATA_DIR=./data

# === Backup cron (M12 production only) ===
BACKUP_GITHUB_TOKEN=
BACKUP_REPO=Jp8617465-sys/asxos-backups

# === Healthchecks ping URLs ===
HEALTHCHECKS_WRITE_KEY=
HEALTHCHECK_URL_SYNC_PRICES=
HEALTHCHECK_URL_SYNC_FUNDAMENTALS=
HEALTHCHECK_URL_GENERATE_SIGNALS=
HEALTHCHECK_URL_INGEST_REGULATORY=
HEALTHCHECK_URL_COMPOSE_BRIEF=
HEALTHCHECK_URL_RETRAIN_MODEL_A=
HEALTHCHECK_URL_SYNC_UNIVERSE=
HEALTHCHECK_URL_BACKUP_IRREPLACEABLE=
HEALTHCHECK_URL_INGEST_MARKET_CONTEXT=

# === Local dev only ===
# Set to "1" to skip the migration drift check at lifespan startup.
# Use for offline docker-compose dev when supabase_migrations table is absent.
SKIP_MIGRATION_DRIFT_CHECK=0
