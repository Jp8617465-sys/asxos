<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>asxos brief — {{ d.as_of }}</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; max-width: 640px; margin: 1em auto; color: #222; }
    h1 { font-size: 1.2em; margin: 0 0 0.4em; }
    h2 { font-size: 1em; margin: 1.2em 0 0.3em; text-transform: uppercase; letter-spacing: 0.04em; color: #555; }
    .meta { color: #666; font-size: 0.9em; margin-bottom: 0.8em; }
    .banner { background: #fee; border-left: 4px solid #c00; padding: 0.6em 0.8em; margin-bottom: 1em; }
    .caveat { background: #eef3fb; border-left: 4px solid #36c; padding: 0.5em 0.8em; margin: 0.6em 0; font-size: 0.85em; color: #334; }
    table { border-collapse: collapse; width: 100%; font-size: 0.95em; }
    th, td { border-bottom: 1px solid #eee; padding: 0.35em 0.5em; text-align: left; }
    th { background: #f7f7f7; }
    .empty { color: #888; font-style: italic; }
    .label-STRONG_BUY    { color: #0a6; font-weight: 600; }
    .label-BUY           { color: #0a6; }
    .label-HOLD          { color: #888; }
    .label-SELL          { color: #c50; }
    .label-STRONG_SELL   { color: #c00; font-weight: 600; }
    .sentiment-positive  { color: #0a6; }
    .sentiment-negative  { color: #c00; }
    .disc-red            { color: #c00; font-weight: 600; }
    .disc-yellow         { color: #c50; }
    .disc-info           { color: #666; }
  </style>
</head>
<body>
  <h1>asxos brief — {{ d.as_of }}</h1>
  {% if d.model_shelved %}
  <p class="meta">Model A: <strong>shelved</strong> — signal engine paused (rule #11) · Holdings: {{ d.holdings_count }}</p>
  {% elif d.signals_stale %}
  <p class="meta">Regime: <strong style="color:#c00">unavailable</strong> — latest signal: {{ d.latest_signal_date or "none" }} · Holdings: {{ d.holdings_count }}</p>
  {% else %}
  <p class="meta">Regime: <strong>{{ d.regime }}</strong> · Holdings: {{ d.holdings_count }}</p>
  {% endif %}

  {% if d.model_shelved %}
  <p class="caveat">
    <strong>Model A shelved.</strong> The signal engine is dormant (rule #11); this
    brief is model-independent — discipline, tax, regulatory, and job-health only.
  </p>
  {% else %}
  <p class="caveat">
    <strong>Signal caveat:</strong> labels are experimental model-derived rankings.
    Expected-return calibration and adjusted-price basis are under review.
    Treat signals as decision-support context only, not trade instructions.
  </p>
  {% endif %}

  {% if d.prices_stale or (d.signals_stale and not d.model_shelved) %}
  <div class="banner">
    <strong>Data freshness warning.</strong>
    <ul>
      {% if d.prices_stale %}<li>Prices stale — latest price date: {{ d.latest_price_date or "no data" }}</li>{% endif %}
      {% if d.signals_stale and not d.model_shelved %}<li>Signals stale — latest signal run: {{ d.latest_signal_date or "no data" }}</li>{% endif %}
    </ul>
  </div>
  {% endif %}

  {% if d.has_failures %}
  <div class="banner">
    <strong>Job failures in the last 24h.</strong>
    <ul>
      {% for f in d.job_failures %}
      <li><code>{{ f.job_name }}</code> ({{ f.as_of }}): {{ f.error_message }}</li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  {% if d.discipline_findings %}
  <h2>Portfolio discipline</h2>
  {% set disc_errors = d.discipline_findings | selectattr("level", "equalto", "error") | list %}
  {% set disc_items = d.discipline_findings | rejectattr("level", "equalto", "error") | list %}
  {% if disc_errors %}
  <div class="banner">
    <strong>Discipline checks that could not run.</strong>
    <ul>
      {% for f in disc_errors %}
      <li>{{ f.message }}</li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
  {% if disc_items %}
  <ul>
    {% for f in disc_items %}
    <li class="disc-{{ f.level }}">{{ f.message }}</li>
    {% endfor %}
  </ul>
  {% endif %}
  {% endif %}

  {% if not d.model_shelved %}
  <h2>Signal changes on holdings</h2>
  {% if d.signal_changes %}
  <table>
    <tr><th>symbol</th><th>was</th><th>now</th><th>top driver</th></tr>
    {% for c in d.signal_changes %}
    <tr>
      <td>{{ c.symbol }}</td>
      <td class="label-{{ c.old_label }}">{{ c.old_label }}</td>
      <td class="label-{{ c.new_label }}">{{ c.new_label }}</td>
      <td><code>{{ c.top_factor }}</code></td>
    </tr>
    {% endfor %}
  </table>
  {% else %}
  <p class="empty">No label changes overnight.</p>
  {% endif %}
  {% endif %}

  <h2>Regulatory hits on holdings (last 24h)</h2>
  {% if d.regulatory_hits %}
  <ul>
    {% for r in d.regulatory_hits %}
    <li><strong>{{ r.symbol }}</strong> · {{ r.source }} ({{ r.kind }}): {{ r.title }} — {{ r.published_at }}</li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="empty">No regulatory hits on current holdings.</p>
  {% endif %}

  {% if d.news_items %}
  <h2>Market news on holdings (last 24h)</h2>
  <ul>
    {% for n in d.news_items %}
    <li>
      <strong>{{ n.symbols | join(", ") }}</strong> ·
      <a href="{{ n.url }}">{{ n.title }}</a>
      {# Publisher before the date: who said it changes what the headline is
         worth. Omitted entirely when the URL has no parseable host, rather
         than printing an empty or invented attribution. #}
      {% if n.source %}— <span class="source">{{ n.source }}</span>{% endif %}
      — {{ n.published_at }}
      {% if n.sentiment %}<em class="sentiment-{{ n.sentiment }}">({{ n.sentiment }})</em>{% endif %}
    </li>
    {% endfor %}
  </ul>
  {% endif %}

  {% if d.portfolio_section %}
  {% set p = d.portfolio_section %}
  <h2>Portfolio adjustments (run #{{ p.run_id }} · {{ p.run_as_of }})</h2>
  <p class="meta">
    Turnover ${{ "%.0f"|format(p.turnover_aud) }} ·
    Buys +${{ "%.0f"|format(p.total_buy_aud) }} ·
    Sells ${{ "%.0f"|format(p.total_sell_aud) }}
  </p>
  {% if p.top_buys %}
  <table>
    <tr><th colspan="2">Top buys</th></tr>
    {% for t in p.top_buys %}
    <tr>
      <td>{{ t.symbol }}</td>
      <td style="text-align:right">+${{ "%.0f"|format(t.delta_aud) }}</td>
    </tr>
    {% endfor %}
  </table>
  {% endif %}
  {% if p.top_sells %}
  <table style="margin-top:0.4em">
    <tr><th colspan="2">Top sells</th></tr>
    {% for t in p.top_sells %}
    <tr>
      <td>{{ t.symbol }}</td>
      <td style="text-align:right">${{ "%.0f"|format(t.delta_aud) }}</td>
    </tr>
    {% endfor %}
  </table>
  {% endif %}
  <p style="font-size:0.8em;color:#888;">
    For personal use only (s766B Corporations Act 2001).
    Run <code>asx propose-trades --run-id {{ p.run_id }}</code> for full details.
  </p>
  {% endif %}
</body>
</html>
